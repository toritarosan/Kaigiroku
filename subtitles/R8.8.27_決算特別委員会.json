    },
    {
      "start": 141.24,
      "duration": 2.0,
      "text": "ただし議題に入ります議題は"
    },
    {
      "start": 143.24,
      "duration": 2.0,
      "text": "当委員会の委員長の御選についてであります"
    },
    {
      "start": 145.24,
      "duration": 3.0,
      "text": "御選の方法についてはいかがいたしましょうか"
    },
    {
      "start": 148.24,
      "duration": 3.0,
      "text": "どなたか選出方法についてご意見がありませんか"
    },
    {
      "start": 151.24,
      "duration": 3.6,
      "text": "安田さん"
    },
    {
      "start": 154.84,
      "duration": 3.0,
      "text": "指名推薦を提案します"
    },
    {
      "start": 157.84,
      "duration": 3.12,
      "text": "ただいま指名推薦選出方法について"
    },
    {
      "start": 160.96,
      "duration": 2.6,
      "text": "指名推薦によるとのご意見がありますが"
    },
    {
      "start": 163.56,
      "duration": 4.08,
      "text": "指名推薦による決定でご意見はありませんでしょうか"
    },
    {
      "start": 167.64,
      "duration": 3.64,
      "text": "ご意見なしと認めただいま申し上げたとおり決定いたします"
    },
    {
      "start": 171.28,
      "duration": 3.02,
      "text": "どなたかご推薦いただけますでしょうか"
    },
    {
      "start": 174.3,
      "duration": 1.51,
      "text": "安田さん"
    },
    {
      "start": 175.81,
      "duration": 4.6,
      "text": "はい 決算議会はとても会期が長くて"
    },
    {
      "start": 180.41,
      "duration": 2.76,
      "text": "自給力というか体力も必要なんですけれども"
    },
    {
      "start": 183.17,
      "duration": 5.47,
      "text": "いつもこれまでも何回か受けていただいたのかなと思いますが"
    },
    {
      "start": 188.64,
      "duration": 3.36,
      "text": "三谷孝子さんが適任かなというふうに思いますので"
    },
    {
      "start": 192.0,
      "duration": 2.56,
      "text": "推薦させていただきます"
    },
    {
      "start": 194.56,
      "duration": 4.56,
      "text": "ただいま三谷孝子委員を委員長にとの推薦がございました"
    },
    {
      "start": 199.12,
      "duration": 1.16,
      "text": "お諮りいたします"
    },
    {
      "start": 200.28,
      "duration": 4.2,
      "text": "三谷孝子委員を委員長に選出することにご意見はありませんか"
    },
    {
      "start": 204.48,
      "duration": 1.0,
      "text": "ご意見なしと認めます"
    },
    {
      "start": 205.48,
      "duration": 2.76,
      "text": "従ってただいま示しました通り"
    },
    {
      "start": 208.24,
      "duration": 2.8,
      "text": "選出することに決定いたしました"
    },
    {
      "start": 211.04,
      "duration": 1.76,
      "text": "ただいま委員長に選出されました"
    },
    {
      "start": 212.8,
      "duration": 5.08,
      "text": "実際に高子委員のご挨拶をお願いいたします"
    },
    {
      "start": 217.88,
      "duration": 4.4,
      "text": "はい ご推薦いただき また皆様のご承認をいただきありがとうございます"
    },
    {
      "start": 222.28,
      "duration": 4.36,
      "text": "皆様から信頼していただけるような 委員会の応援に努めてまいりますので"
    },
    {
      "start": 226.64,
      "duration": 6.13,
      "text": "ご協力 どうぞよろしくお願いいたします"
    },
    {
      "start": 232.77,
      "duration": 2.28,
      "text": "これで私の職務は終了いたしました"
    },
    {
      "start": 235.05,
      "duration": 31.16,
      "text": "委員長と交代するため しばらく休憩いたします"
    },
    {
      "start": 266.21,
      "duration": 1.4,
      "text": "再開いたします"
    },
    {
      "start": 267.61,
      "duration": 2.4,
      "text": "これから副委員長のご選を行います"
    },
    {
      "start": 270.01,
      "duration": 2.64,
      "text": "ご選の方法についてはいかがいたしましょうか"
    },
    {
      "start": 272.65,
      "duration": 3.0,
      "text": "どなたか 選出方法について ご意見がありませんか"
    },
    {
      "start": 275.65,
      "duration": 2.09,
      "text": "はい 渡辺大蔵さん"
    },
    {
      "start": 277.74,
      "duration": 4.55,
      "text": "知事・渡辺大蔵さん 指名推薦でお願いいたします"
    },
    {
      "start": 284.29,
      "duration": 4.0,
      "text": "ただいま 選出方法について 指名推薦によるとのご意見がありますが"
    },
    {
      "start": 288.29,
      "duration": 4.09,
      "text": "指名推薦により 決定することに ご意義ありませんか"
    },
    {
      "start": 292.38,
      "duration": 4.0,
      "text": "ご意義なしと認め ただいま 申し上げたとおり 決定いたします"
    },
    {
      "start": 296.38,
      "duration": 2.0,
      "text": "どなたか ご推薦いただけますか"
    },
    {
      "start": 298.38,
      "duration": 2.93,
      "text": "はい 渡辺さん"
    },
    {
      "start": 301.31,
      "duration": 5.0,
      "text": "小金市議会にはですね、緑町に住んでいる議員が2名おりましてですね、"
    },
    {
      "start": 306.31,
      "duration": 7.87,
      "text": "私と藤川議員なんですが、ご近所の吉見で藤川さんを推薦申し上げたいと思います。"
    },
    {
      "start": 314.18,
      "duration": 5.0,
      "text": "ただいま、藤川県自委員を副院長にとの推薦がございました。"
    },
    {
      "start": 319.18,
      "duration": 5.0,
      "text": "お諮りいたします。藤川県自委員を副院長に占任することにご意義ありませんか。"
    },
    {
      "start": 324.18,
      "duration": 2.0,
      "text": "ご意義なしと認めます。"
    },
    {
      "start": 326.18,
      "duration": 5.0,
      "text": "従って、ただいま指名いたしましたとおり、選出することに決定いたしました。"
    },
    {
      "start": 331.18,
      "duration": 5.0,
      "text": "ただいま副委員長に選出された藤川県事委員のご挨拶をお願いいたします"
    },
    {
      "start": 336.18,
      "duration": 1.0,
      "text": "藤川さん"
    },
    {
      "start": 337.18,
      "duration": 5.99,
      "text": "ただいま副委員長に推薦されました藤川です"
    },
    {
      "start": 343.17,
      "duration": 1.0,
      "text": "ありがとうございます"
    },
    {
      "start": 344.17,
      "duration": 2.0,
      "text": "でも"
    },
    {
      "start": 348.36,
      "duration": 3.0,
      "text": "選出していただいた藤川です"
    },
    {
      "start": 351.36,
      "duration": 1.0,
      "text": "ありがとうございます"
    },
    {
      "start": 352.36,
      "duration": 4.0,
      "text": "本当に意義なしでいいんですかと思うんですけど"
    },
    {
      "start": 356.36,
      "duration": 2.0,
      "text": "選出された以上は"
    },
    {
      "start": 358.36,
      "duration": 6.29,
      "text": "しっかり水谷さんを支え ケッサン特別委員会"
    },
    {
      "start": 364.65,
      "duration": 4.0,
      "text": "スムーズな運営に進めてまいりたいと思います よろしくお願いします"
    },
    {
      "start": 368.65,
      "duration": 9.54,
      "text": "以上でケッサン特別委員会の会議を終了いたします"
    },
    {
      "start": 378.19,
      "duration": 6.95,
      "text": "この後 審査区分などについて協議を行います"
    },
    {
      "start": 392.07,
      "duration": 3.0,
      "text": "審査区分についてですけれども"
    },
    {
      "start": 395.07,
      "duration": 11.0,
      "text": "採出の質疑に関しましては、8月24日に行われました議会運営委員会にて、全体を4区分に分けて行うことと確認されています。"
    },
    {
      "start": 406.07,
      "duration": 10.0,
      "text": "詳細に関しましては、本日お配りしてあります令和8年第3回定例会、決算特別委員会審査区分についてをご参照ください。"
    },
    {
      "start": 416.07,
      "duration": 6.35,
      "text": "次に、第1、第2副市長及び教育庁の出席についてです。"
    },
    {
      "start": 422.42,
      "duration": 22.08,
      "text": "第1、第2副市長については、それぞれの担当する事務に関係する決算審査を行う日のみ、また教育長については、教育委員会に関係する決算審査を行う日のみ委員会に出席していただき、その他は、自席にて審査を聞いていただきたいと思います。"
    },
    {
      "start": 444.5,
      "duration": 16.0,
      "text": "その他でございますけれども、委員会の進行については、8月24日の議会運営委員会で確認したとおりに行っていただきますよう、皆様のご協力を、格段のご配慮をまたお願いいたします。"
    },
    {
      "start": 460.5,
      "duration": 12.1,
      "text": "確認ですけれども、お手元に新作部についてはお配りをしておりますので、ご確認ください。"
    },
    {
      "start": 472.6,
      "duration": 22.28,
      "text": "次に資料要求についてですが、資料要求書を定例会2日目、つまり明日、8月28日の午後5時までに議会事務局に提出していただくということで、議会運営委員会の方で決定をしております。"
    },
    {
      "start": 494.88,
      "duration": 8.36,
      "text": "ご注意をいただきたいんですけれども今日は一般会計の説明までしか言っておりませんけれども 資料要求は特別会計まで含む"
    },
    {
      "start": 503.24,
      "duration": 8.33,
      "text": "全ての資料要求についてお願いしたいと思います"
    },
    {
      "start": 511.57,
      "duration": 8.36,
      "text": "内容などについてのご調整が必要になるかもしれませんけれども 明日が休みというか休会ですよね"
    },
    {
      "start": 519.93,
      "duration": 10.32,
      "text": "広報庫庁協議会で決算状態の続きができませんので これが先に伸びるとちょっと日程的に難しいということですのでご協力をいただければと思います"
    },
    {
      "start": 530.25,
      "duration": 7.43,
      "text": "特別会計も明日5時までに ちょっと今回日程が変則的なんですよね"
    },
    {
      "start": 537.68,
      "duration": 9.8,
      "text": "議長日程とか市長日程が入ってますので ということで皆さんご協力のほどよろしくお願いいたします"
    },
    {
      "start": 547.48,
      "duration": 5.08,
      "text": "期日については今申し上げたとおりで 明日の午後5時までとなります"
    },
    {
      "start": 552.56,
      "duration": 7.4,
      "text": "提出される場合は ガルーンにて送付するファイルをお使いください"
    },
    {
      "start": 559.96,
      "duration": 1.52,
      "text": "用意識をお使いください"
    },
    {
      "start": 561.48,
      "duration": 5.88,
      "text": "提出される際には 送信後に議会事務局まで電話をお願いいたします"
    },
    {
      "start": 567.36,
      "duration": 3.8,
      "text": "紙でも大丈夫です"
    },
    {
      "start": 571.16,
      "duration": 2.88,
      "text": "電子での場合は届いてなかったりとか"
    },
    {
      "start": 574.04,
      "duration": 8.24,
      "text": "確認が漏れたりすることがあるので 電話をお願いいたします"
    },
    {
      "start": 582.28,
      "duration": 9.32,
      "text": "特に様式は変わってないので あと 様式っていうファイルも"
    },
    {
      "start": 591.6,
      "duration": 4.72,
      "text": "コールダーもありますので そこにもあります"
    },
    {
      "start": 596.32,
      "duration": 7.68,
      "text": "じゃあファイルにも入れていただくように お願いしたいと思います"
    },
    {
      "start": 604.0,
      "duration": 4.2,
      "text": "資料要求については 次の通りといたしますので"
    },
    {
      "start": 608.2,
      "duration": 6.0,
      "text": "申し上げます 既存の事務報告書及び各種"
    },
    {
      "start": 614.2,
      "duration": 6.76,
      "text": "報告書等に記載され議員に配布されている事項については対象外といたします"
    },
    {
      "start": 620.96,
      "duration": 6.64,
      "text": "2 多市との比較資料についてはできる限り近隣市または類似市との比較とします"
    },
    {
      "start": 627.6,
      "duration": 8.2,
      "text": "26市を対象とした資料については要求前にあらかじめ担当部局と調整するように配慮するものとします"
    },
    {
      "start": 635.8,
      "duration": 9.13,
      "text": "う 交差比比率等の未確定のまた未公表の資料は資料要求の対象外とします"
    },
    {
      "start": 644.93,
      "duration": 8.0,
      "text": "決算内容と関連あるものを除き 予算一般についての資料については資料要求の対象外とします"
    },
    {
      "start": 652.93,
      "duration": 7.0,
      "text": "お 改めて前科を対象とした調査を必要とする資料は資料要求の対象外とします"
    },
    {
      "start": 659.93,
      "duration": 7.0,
      "text": "ただし、要求前にあらかじめ担当部局と調整ができたものについては、資料要求をすることができます。"
    },
    {
      "start": 666.93,
      "duration": 7.0,
      "text": "か、各市ホームページ等により公開されているものは、資料要求の対象外とします。"
    },
    {
      "start": 673.93,
      "duration": 11.96,
      "text": "要求のあった資料については 9月17日の本会議整理日までに調整して配布される予定ですが"
    },
    {
      "start": 685.89,
      "duration": 8.51,
      "text": "資料要求の内容により 決算特別委員会の当日となる場合もありますということで ご承知おきをください"
    },
    {
      "start": 694.4,
      "duration": 4.16,
      "text": "続きまして 電票閲覧についてでございます"
    },
    {
      "start": 698.56,
      "duration": 4.0,
      "text": "電票の閲覧については 1人30分以内とします"
    },
    {
      "start": 702.56,
      "duration": 17.7,
      "text": "閲覧日時は9月8日9日及び8日9日10日のいずれも午前11時から正午午後3時45分から午後4時45分となります"
    },
    {
      "start": 720.26,
      "duration": 8.4,
      "text": "なお 電表の閲覧申込書は8月24日に各委員にがルーデンで既に送付されていると思います"
    },
    {
      "start": 728.66,
      "duration": 7.54,
      "text": "提出期限は明日8月28日の午後5時までといたします 資料要求書と同じ時間となります"
    },
    {
      "start": 736.2,
      "duration": 8.28,
      "text": "提出される場合は同じく議会事務局まで電話 または実際直接言って確認をお願いいたします"
    },
    {
      "start": 744.48,
      "duration": 11.18,
      "text": "また申込書には閲覧日及び閲覧時間の希望を記入していただきますが 会計化の業務の都合により閲覧日及び閲覧時間を調整させていただく場合がありますので"
    },
    {
      "start": 755.66,
      "duration": 3.16,
      "text": "あらかじめご了承を願います"
    },
    {
      "start": 758.82,
      "duration": 2.0,
      "text": "ということで競技事項として"
    },
    {
      "start": 760.82,
      "duration": 4.0,
      "text": "これまでの確認事項を整理して申し上げました"
    },
    {
      "start": 764.82,
      "duration": 5.0,
      "text": "皆様の方から何かご発言はありますでしょうか"
    },
    {
      "start": 769.82,
      "duration": 2.06,
      "text": "はい、沖浦さん"
    },
    {
      "start": 771.88,
      "duration": 4.0,
      "text": "確か昨年度なんですけれども"
    },
    {
      "start": 775.88,
      "duration": 3.0,
      "text": "事務事業評価シートというか"
    },
    {
      "start": 778.88,
      "duration": 6.0,
      "text": "ちょうど試作評価結果というタイトルの"
    },
    {
      "start": 784.88,
      "duration": 13.0,
      "text": "事務事業評価の資料が、計算特別委員会の始まりを本当2日前ぐらいにパッと配られて、それをもとに質疑はなかなかできなかったというのがあって、"
    },
    {
      "start": 797.88,
      "duration": 11.0,
      "text": "それは指摘そのときはさせていただいたんですけれども、今年度はちゃんと配られますか、どうですかという、そういうことをお伺いしたいと思います。"
    },
    {
      "start": 808.88,
      "duration": 7.03,
      "text": "私の方は特に何も事前には聞いておりません。もちろんさっき選ばれたばかりです。"
    },
    {
      "start": 815.91,
      "duration": 4.12,
      "text": "どのように確認しますか。"
    },
    {
      "start": 820.03,
      "duration": 8.05,
      "text": "事務事務業評価などの、昨年も指摘があった資料の件ですよね。"
    },
    {
      "start": 828.08,
      "duration": 3.74,
      "text": "ちょっと確認ができますか。"
    },
    {
      "start": 831.82,
      "duration": 5.62,
      "text": "今でなくてもよろしいですか。"
    },
    {
      "start": 837.44,
      "duration": 7.13,
      "text": "分かりました。今まだ議員の手元に配られていないということです。"
    },
    {
      "start": 844.57,
      "duration": 11.8,
      "text": "今即答できないんですけど、そういうご要望があったことについてお伝えしておきますので、なるべく早い時期に配るように伝えておきます。"
    },
    {
      "start": 856.37,
      "duration": 10.35,
      "text": "はい、わかりました。ありがとうございます。"
    },
    {
      "start": 866.72,
      "duration": 7.52,
      "text": "それでは、その他にご発言とございますでしょうか。"
    },
    {
      "start": 874.24,
      "duration": 7.75,
