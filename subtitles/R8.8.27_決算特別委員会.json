{
  "MWmyQKBwG0Y": [
    {
      "start": 124.91,
      "duration": 7.33,
      "text": "お揃いですので始めたいと思います"
    },
    {
      "start": 132.24,
      "duration": 3.0,
      "text": "ただいまから決算特別委員会の会議を開きます"
    },
    {
      "start": 135.24,
      "duration": 4.0,
      "text": "本日は年長の私が委員長が御選されるまでの間"
    },
    {
      "start": 139.24,
