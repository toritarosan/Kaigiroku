      "text": "議長の諮問事項1件、調査1件の計2件であります。"
    },
    {
      "start": 333.0,
      "text": "議長からお手元に議会運営委員会協議事項が提示されておりますので、"
    },
    {
      "start": 338.0,
      "text": "その順序に従って順次協議をしてまいりたいと思います。"
    },
    {
      "start": 342.0,
      "text": "議会運営に関する議長の諮問事項についてお議題といたします。"
    },
    {
      "start": 346.0,
      "text": "はじめに協議事項1、市長送付案件の取扱いについて行います。"
    },
    {
      "start": 351.0,
      "text": "部局から発言があればお願いします。"
    },
    {
      "start": 354.0,
      "text": "総務部長。"
    },
    {
      "start": 357.0,
      "text": "おはようございます。"
    },
    {
      "start": 359.0,
      "text": "追加送付及び後日送付案件についてご報告いたします。"
    },
    {
      "start": 363.0,
      "text": "追加送付案件として、9月11日付、議案第71号、"
    },
    {
      "start": 368.0,
      "text": "消防ポンプ自動車の買い入れについて、"
    },
    {
      "start": 371.0,
      "text": "後日送付案件として、9月15日付、議案第72号、"
    },
    {
      "start": 376.0,
      "text": "小金井市会計年度任用職員の報酬等に関する条例の一部を改正する条例を"
    },
    {
      "start": 381.0,
      "text": "送付させていただきましたので、取扱い方よろしくお願いいたします。"
    },
    {
      "start": 386.0,
      "text": "なお、本2件につきましては、本会議での速決をお願いいたします。"
    },
    {
      "start": 390.0,
      "text": "取扱いについて、議長の諮問案が提示されておりますので、"
    },
    {
      "start": 394.0,
      "text": "説明をお願いします。議長。"
    },
    {
      "start": 397.0,
      "text": "事務局から説明いたします。"
    },
    {
      "start": 398.0,
      "text": "局長。"
    },
    {
      "start": 400.0,
      "text": "議案第71号及び議案第72号につきましては、"
    },
    {
      "start": 404.0,
      "text": "9月18日の本会議に上呈し、説明、質疑後、委員会不得を省略し、"
    },
    {
      "start": 410.0,
      "text": "速決することとしたいというのが議長の諮問案でございます。"
    },
    {
      "start": 413.0,
      "text": "議長及び事務局の説明は終わりました。"
    },
    {
      "start": 416.0,
      "text": "ご意見、ご審議とございますか。"
    },
    {
      "start": 419.0,
      "text": "お諮りいたします。"
    },
    {
      "start": 420.0,
      "text": "本件については議長の諮問のとおり決定することにご異議ありませんか。"
    },
    {
      "start": 424.0,
      "text": "ご異議なしと認めます。"
    },
    {
      "start": 426.0,
      "text": "したがって本件は議長の諮問のとおり決定いたしました。"
    },
    {
      "start": 429.0,
      "text": "共有事項2その他でございますが、何かご発言ございますか。"
    },
    {
      "start": 434.0,
      "text": "以上で議会運営に関する議長の諮問事項についてを終わります。"
    },
    {
      "start": 440.0,
      "text": "次に議会改革に関する諸問題の調査を議題といたします。"
    },
    {
      "start": 445.0,
      "text": "1議会改革について行います。"
    },
    {
      "start": 448.0,
      "text": "直ちに7-4市議会オンライン会議についてを議題といたします。"
    },
    {
      "start": 453.0,
      "text": "8月24日に事務局からガルーンで送付したオンライン会議機器見積金額のうち"
    },
    {
      "start": 461.0,
      "text": "パソコン広角カメラ及び広角カメラの三脚を除いた金額で"
    },
    {
      "start": 466.0,
      "text": "予算要求を行うかを持ち帰っていただいておりますので"
    },
    {
      "start": 471.0,
      "text": "皆さんからそれぞれご発言いただきたいと思いますが"
    },
    {
      "start": 476.0,
      "text": "予算要求でよろしいですか。"
    },
    {
      "start": 480.0,
      "text": "予算要求を行うということを一応決定いたしました。"
    },
    {
      "start": 491.0,
      "text": "それでは本件については引き続き協議するということでよろしいでしょうか。"
    },
    {
      "start": 497.0,
      "text": "本件については引き続き協議することといたしました。"
    },
    {
      "start": 501.0,
      "text": "次に2議会基本条例について行います。"
    },
    {
      "start": 505.0,
      "text": "直ちに議会BCPについてを議題といたします。"
    },
    {
      "start": 509.0,
      "text": "皆さんのところに小林副議長が作成したハンドブック案が"
    },
    {
      "start": 515.0,
      "text": "すでに送付されていると思いますが"
    },
    {
      "start": 520.0,
      "text": "小林副委員長が作ったハンドブックについて"
    },
    {
      "start": 524.0,
      "text": "案についてご説明いただきたいと思います。"
    },
    {
      "start": 530.0,
      "text": "小林副議長"
    },
    {
      "start": 532.0,
      "text": "おはようございます。"
    },
    {
      "start": 534.0,
      "text": "前回委員長の方で作っていただいたハンドブックがありますが"
    },
    {
      "start": 538.0,
      "text": "あれは武蔵野のガイドブックをもとに作っていただいたもので"
    },
    {
      "start": 543.0,
      "text": "あれも非常に使い勝手がいいかなと思ったのですが"
    },
    {
      "start": 547.0,
      "text": "もう少し書道記の方に絞って"
    },
    {
      "start": 551.0,
      "text": "今皆さん胸ポケットに入っていると思いますが"
    },
    {
      "start": 555.0,
      "text": "持ち歩けるような形でやったらいいのではないかという話の中で"
    },
    {
      "start": 561.0,
      "text": "ちょっとアンを作ってみるということで"
    },
    {
      "start": 564.0,
      "text": "今回お配りさせていただきました。"
    },
    {
      "start": 566.0,
      "text": "ガールの方に元データも載っていますが"
    },
    {
      "start": 569.0,
      "text": "こんな形でA4一枚で出てきますので"
    },
    {
      "start": 573.0,
      "text": "この切り取りのところを切り取ってもらって"
    },
    {
      "start": 577.0,
      "text": "下のところがあるので"
    },
    {
      "start": 579.0,
      "text": "切り取ってもらって三つ折りにして"
    },
    {
      "start": 583.0,
      "text": "この片方をのりしろにすると"
    },
    {
      "start": 586.0,
      "text": "今お手元にあるような形でなるようになっております。"
    },
    {
      "start": 591.0,
      "text": "やはりA4サイズ、名刺サイズまでやると"
    },
    {
      "start": 594.0,
      "text": "ちょっと文字が入りきらないところもあったので"
    },
    {
      "start": 598.0,
      "text": "このような少し一回り大きく"
    },
    {
      "start": 600.0,
      "text": "財布に入る形かなと思っておりますが"
    },
    {
      "start": 603.4000000953674,
      "text": "ご検討いただければと思います"
    },
    {
      "start": 605.4000000953674,
      "text": "基本的には今のBCPの計画の中身を"
    },
    {
      "start": 610.6199998855591,
      "text": "落とし込んだ形になっていますが"
    },
    {
      "start": 612.6199998855591,
      "text": "今の計画の中に"
    },
    {
      "start": 614.6199998855591,
      "text": "ガルーンに登録するという文言がありませんので"
    },
    {
      "start": 618.7399997711182,
      "text": "そこは独自で文字に起こしているところもありますので"
    },
    {
      "start": 622.6599998474121,
      "text": "併せてその辺りも"
    },
    {
      "start": 624.6599998474121,
      "text": "ご確認をいただければと思います"
    },
    {
      "start": 627.3199996948242,
      "text": "最後補足で7ページ"
    },
    {
      "start": 630.8199996948242,
      "text": "7と書いてあるところの"
    },
    {
      "start": 632.8199996948242,
      "text": "緊急時チェックリストという"
    },
    {
      "start": 634.8199996948242,
      "text": "下のところに赤い四角が2つあるのは"
    },
    {
      "start": 637.8199996948242,
      "text": "これは独自のチェック項目などを"
    },
    {
      "start": 643.1800003051758,
      "text": "書いていただけたらより"
    },
    {
      "start": 645.1800003051758,
      "text": "カスタマイズできるかなと思ったので"
    },
    {
      "start": 647.1800003051758,
      "text": "そんな形にしておりますので"
    },
    {
      "start": 649.1800003051758,
      "text": "ご検討ください 以上です"
    },
    {
      "start": 652.1800003051758,
      "text": "【佐藤】現時点で皆さんから何か"
    },
    {
      "start": 655.1800003051758,
      "text": "質問とご意見などありますか"
    },
    {
      "start": 659.1800003051758,
      "text": "よろしいですか"
    },
    {
      "start": 661.1800003051758,
      "text": "今日のところは説明を受けて"
    },
    {
      "start": 665.1800003051758,
      "text": "一応両班2つの案が出ておりますので"
    },
    {
      "start": 669.1800003051758,
      "text": "どっちの案でいくかということについては"
    },
    {
      "start": 671.1800003051758,
      "text": "決めた上で"
    },
    {
      "start": 673.1800003051758,
      "text": "皆さんからご意見をもらって"
    },
    {
      "start": 675.1800003051758,
      "text": "いくという形にしたいと思いますので"
    },
    {
      "start": 679.1800003051758,
      "text": "どちらかにするかということについては"
    },
    {
      "start": 681.1800003051758,
      "text": "今日は持ち帰っていただいて"
    },
    {
      "start": 683.1800003051758,
      "text": "最終日の議運でまた確認したいと思いますので"
    },
    {
      "start": 687.1800003051758,
      "text": "よろしくお願いします"
    },
    {
      "start": 690.1800003051758,
      "text": "最終日だからあさって"
    },
    {
      "start": 692.1800003051758,
      "text": "18日でもいいですし"
    },
    {
      "start": 694.1800003051758,
      "text": "10月の最終本会議のときでも"
    },
    {
      "start": 697.1800003051758,
      "text": "かまわりませんので"
    },
    {
      "start": 700.1800003051758,
      "text": "まず議運でどっちでいくか"
    },
    {
      "start": 702.1800003051758,
      "text": "ということを決めた上で"
    },
    {
      "start": 704.1800003051758,
      "text": "皆さんに意見をもらったほうがいいかなと"
    },
    {
      "start": 707.1800003051758,
      "text": "今日はちょっとこの場では"
    },
    {
      "start": 711.1800003051758,
      "text": "決定という形になりませんので"
    },
    {
      "start": 716.1800003051758,
      "text": "ということで皆さんいいですか"
    },
    {
      "start": 719.1800003051758,
      "text": "特に何か"
    },
    {
      "start": 721.1800003051758,
      "text": "お諮りいたします"
    },
    {
      "start": 722.1800003051758,
      "text": "議会基本条例については"
    },
    {
      "start": 724.1800003051758,
      "text": "現時点での質疑を終了することに"
    },
    {
      "start": 726.1800003051758,
      "text": "ご異議ありませんか"
    },
    {
      "start": 727.1800003051758,
      "text": "ご異議なしと認めます"
    },
    {
      "start": 729.1799926757812,
      "text": "したがって議会基本条例についての"
    },
    {
      "start": 731.1799926757812,
      "text": "現時点での質疑を終了いたします"
    },
    {
      "start": 733.1799926757812,
      "text": "次にその他について何かございますか"
    },
    {
      "start": 737.1799926757812,
      "text": "お諮りいたします"
    },
    {
      "start": 738.1799926757812,
      "text": "議会改革に関する諸問題の調査につきましては"
    },
    {
      "start": 741.1799926757812,
      "text": "現時点での質疑を終了し"
    },
    {
      "start": 743.1799926757812,
      "text": "継続調査といたしたいと思います"
    },
    {
      "start": 746.1799926757812,
      "text": "これにご異議ありませんか"
    },
    {
      "start": 748.1799926757812,
      "text": "ご異議なしと認めます"
    },
    {
      "start": 749.1799926757812,
      "text": "したがって本件調査は継続調査と決定いたしました"
    },
    {
      "start": 753.1799926757812,
      "text": "以上で党委員会に負託されております"
    },
    {
      "start": 755.1799926757812,
      "text": "案件の審査は全て終了いたしました"
    },
    {
      "start": 758.1799926757812,
      "text": "これで議会運営委員会の会議を閉じ"
    },
    {
      "start": 760.1799926757812,
      "text": "散会いたします"
    },
    {
      "start": 762.1799926757812,
      "text": "お疲れ様でした"
    },
    {
      "start": 792.1799926757812,
      "text": "ご視聴ありがとうございました"
    }
  ]
