{
  "gMA83lnTs88": [
    {
      "start": 0.0,
      "duration": 22.12,
      "text": "お疲れ様です 議会運営委員会協議会を始めます"
    },
    {
      "start": 22.12,
      "duration": 5.16,
      "text": "お手元の協議事項を見ていただいて 委員会の進行予定については"
    },
    {
      "start": 27.28,
      "duration": 8.1,
      "text": "審査案件・議長の諮問事項1件です 議会運営に関する議長の諮問事項について"
    },
    {
      "start": 35.38,
      "duration": 7.0,
      "text": "市長送付案件の取扱いについて 追加送付案件が市長報告となっております"
    },
    {
      "start": 42.38,
      "duration": 7.0,
      "text": "取扱いについては本日の本会議で 所定の手続きを取ることについてです"
    },
    {
      "start": 49.38,
      "duration": 9.82,
      "text": "皆さんから何かありますか? よろしいでしょうか では委員会に入ります"
    },
    {
      "start": 59.2,
      "duration": 5.12,
      "text": "ただいまから議会運営委員会の会議を開きます 直ちに議事に入ります"
    },
    {
      "start": 64.32,
      "duration": 5.12,
      "text": "当委員会に負託されております案件は 議長の諮問事項1件であります"
    },
    {
      "start": 69.44,
      "duration": 4.78,
      "text": "議長からお手元に議会運営委員会協議事項が 提示されておりますので"
    },
    {
      "start": 74.22,
      "duration": 3.72,
      "text": "その順序に従って順次協議をしてまいりたいと思います"
    },
    {
      "start": 77.94,
      "duration": 4.22,
      "text": "議会運営に関する議長の諮問事項について お議題といたします"
    },
    {
      "start": 82.16,
      "duration": 5.76,
      "text": "はじめに協議事項1 市長送付案件の取扱いについて行います"
    },
    {
      "start": 87.92,
      "duration": 5.5,
      "text": "部局から発言があればお願いします 総務部長"
    },
    {
      "start": 93.42,
      "duration": 7.46,
      "text": "本日付で市長報告を送付させていただきましたので 取扱い方よろしくお願いいたします"
    },
    {
      "start": 100.88,
      "duration": 6.78,
      "text": "取扱いについて議長の諮問案が提示されておりますので 説明をお願いします 議長"
    },
    {
      "start": 107.66,
      "duration": 5.52,
      "text": "事務局から説明いたします 市長報告につきましては"
    },
    {
      "start": 113.18,
      "duration": 4.7,
      "text": "本日の本会議で所定の手続きを取りたいというのが 議長の諮問案でございます"
    },
    {
      "start": 117.88,
      "duration": 5.9,
      "text": "議長及び事務局の説明は終わりました ご意見ご質疑等ございますか"
    },
    {
      "start": 123.78,
      "duration": 6.84,
      "text": "岸田さん 本日の市長報告については"
    },
    {
      "start": 130.62,
      "duration": 4.18,
      "text": "24日の議会運営委員会 27日の議会運営委員会についても"
    },
    {
      "start": 134.8,
      "duration": 5.12,
      "text": "その案件の有無を含めて 確認をしてきたところでございます"
    },
    {
      "start": 139.92,
      "duration": 5.48,
      "text": "24日 開会3日前の議会運営委員会において そもそもこの報告があるやなしや"
    },
    {
      "start": 145.4,
      "duration": 5.96,
      "text": "予算の提案があるやなしやということを伺ったところ 現段階ではということで明確なご答弁をいただきませんでした"
    },
    {
      "start": 151.36,
      "duration": 6.2,
      "text": "それから3日後の27日の議会運営委員会において 私の方から再度同じ質問をさせていただいて"
    },
    {
      "start": 157.56,
      "duration": 7.14,
      "text": "ようやくそういったことがあるかもしれないという お話はいただいたというところで"
    },
    {
      "start": 164.7,
      "duration": 7.14,
      "text": "一体何 この2日間で何が変わったんですかということについては 一切ご説明をいただいておりません"
    },
    {
      "start": 171.84,
      "duration": 6.32,
      "text": "先日の会派代表者会議において 私は会派代表者会議のメンバーではございませんので"
    },
    {
      "start": 178.16,
      "duration": 6.64,
      "text": "今日の運びとなったというふうに伺っておりますので それ自体を反対するものではございませんが"
    },
    {
      "start": 184.8,
      "duration": 10.96,
      "text": "しかしながらそのことについて 現段階に至るまで 白石市長及び第一副市長からも何のご説明もいただいておりませんで"
    },
    {
      "start": 195.76,
      "duration": 5.08,
      "text": "何がどうして24日までに こういった整理ができなかったのか"
    },
    {
      "start": 200.84,
      "duration": 7.72,
      "text": "そもそも議会にいてはこうなりますよねと 混沌としちゃいますよということを警告したはずですよね"
    },
    {
      "start": 209.56,
      "duration": 8.0,
      "text": "この影響についてどのようにお考えなんですか それと そこの私がお尋ねしてた理由についてご答弁ください"
    },
    {
      "start": 221.56,
      "duration": 2.0,
      "text": "はい 総務部長"
    },
    {
      "start": 223.56,
      "duration": 8.24,
      "text": "はい 今岸田さんからのお問い合わせということなんですけども ちょっと答えになっているかどうかっていうのはあるんですが"
    },
    {
      "start": 231.8,
      "duration": 8.6,
      "text": "私の方では今ありましたとおり 8月の27日の会派代表者会議でこの件について議論をされて"
    },
    {
      "start": 240.4,
      "duration": 7.12,
      "text": "その中で9月1日に市長報告をということになったということで 今日に至ったということで聞いております"
    },
    {
      "start": 247.52,
      "duration": 9.08,
      "text": "市長報告については一般質問前の9月1日ということで 今日行うこととなったということで確認をしております"
    },
    {
      "start": 256.6,
      "duration": 1.4,
      "text": "はい 岸田さん"
    },
    {
      "start": 258.0,
      "duration": 3.8,
      "text": "今 忌みじくもおっしゃってるように ご答弁にはなっておらなくて"
    },
    {
      "start": 261.8,
      "duration": 5.4,
      "text": "その24日のときにお話をして 市長に伝えますっておっしゃったんですよ 部長はね"
    },
    {
      "start": 267.2,
      "duration": 6.44,
      "text": "それから一切何もないんですよ 話は この日程間について"
    },
    {
      "start": 273.64,
      "duration": 5.6,
      "text": "明日から一般質問始まるんですよ 私も明日の予定者でございますけれども"
    },
    {
      "start": 279.24,
      "duration": 3.04,
      "text": "そういったところにも影響は出るし 今回の一般質問においても"
    },
    {
      "start": 282.28,
      "duration": 4.64,
      "text": "新庁舎建設に絡んでの通告されてる議員も たくさんおられるわけですよ"
    },
    {
      "start": 286.92,
      "duration": 5.8,
      "text": "その内容も今日の報告内容によっては 全然変わってきちゃうじゃないですか"
    },
    {
      "start": 292.72,
      "duration": 3.68,
      "text": "そういったことの影響をどういうふうに 考えてるんですかってことを言ってたんですよ"
    },
    {
      "start": 296.4,
      "duration": 3.08,
      "text": "だから日程をちゃんとしましょうよってことを 事前に言ってたんですよ"
    },
    {
      "start": 299.48,
      "duration": 2.0,
      "text": "それについて"
    },
    {
      "start": 300.0,
      "duration": 3.48,
      "text": "部長は市長に伝えますとおっしゃ ったんですよでもそれがまあ白井市長"
    },
    {
      "start": 303.48,
      "duration": 6.04,
      "text": "からも第一副市長からも何もない まま今日ここに立ってるんですね"
    },
    {
      "start": 309.52,
      "duration": 7.92,
      "text": "本来ここに来て何か説明なりお詫び なりされるべきじゃないですか"
    },
    {
      "start": 317.44,
      "duration": 1.0,
      "text": "はい片山さん"
    },
    {
      "start": 318.44,
      "duration": 5.56,
      "text": "あの今のですねあのことは市長 に直接おっしゃった方がいいじゃない"
    },
    {
      "start": 324.0,
      "duration": 4.0,
      "text": "ですかねこの後本会議があるわけ ですからここで総務部長に答弁"
    },
    {
      "start": 328.0,
      "duration": 2.56,
      "text": "を聞くとはちょっと違うんじゃない かなと思います"
    },
    {
      "start": 330.56,
      "duration": 1.0,
      "text": "はい岸田さん"
    },
    {
      "start": 331.56,
      "duration": 7.44,
      "text": "議会運営委員会の上でお話をしている 経緯がございますので議会運営"
    },
    {
      "start": 339.0,
      "duration": 4.32,
      "text": "委員会でお話をさせていただいた ところでありますし市長の報告"
    },
    {
      "start": 343.32,
      "duration": 3.84,
      "text": "をいただいた後にこの話をする 方が私はむしろ違うのではない"
    },
    {
      "start": 347.16,
      "duration": 2.64,
      "text": "かと思ってここで発言をしている ということです"
    },
    {
      "start": 349.8,
      "duration": 4.68,
      "text": "まあ確かにあの市長のこの間の 進め方については私もあの意見"
    },
    {
      "start": 354.48,
      "duration": 6.2,
      "text": "は持っています本来であればあの 定例会の24日の日はあの要する"
    },
    {
      "start": 360.68,
      "duration": 5.72,
      "text": "に3日前の議運で定例会の要する に整理をするっていう議運だった"
    },
    {
      "start": 366.4,
      "duration": 5.56,
      "text": "ときに議会日程追加日程について は一切説明がされないとそれが"
    },
    {
      "start": 371.96,
      "duration": 4.84,
      "text": "会派代表者会議で今日の市長報告 になるっていうこと自身がちょっと"
    },
    {
      "start": 376.8,
      "duration": 4.8,
      "text": "市長の進め方としては大変問題 があるっていうふうに考えております"
    },
    {
      "start": 381.6,
      "duration": 5.04,
      "text": "しあの24日の日も一応引き知ら さんから市長に伝えるようにっていう"
    },
    {
      "start": 386.64,
      "duration": 7.12,
      "text": "ふうに要求があり総務部長も一応 伝えていただいたとは思うんですが"
    },
    {
      "start": 393.76,
      "duration": 3.68,
      "text": "そのときに市長は何か言っていた のかどうかちょっと確認したい"
    },
    {
      "start": 397.44,
      "duration": 4.64,
      "text": "そのとき伝えたっていうことだけ なんだろうと思いますけれども"
    },
    {
      "start": 402.08,
      "duration": 4.88,
      "text": "そういうことだということであれば そこまでではないかなあとはちょっと"
    },
    {
      "start": 406.96,
      "duration": 6.6,
      "text": "市長にあの進め方についてはあの 聞いていただくしかないかなと思"
    },
    {
      "start": 413.56,
      "duration": 6.24,
      "text": "うんですねあとその私も24日の日 にはこの要するに議運で出された"
    },
    {
      "start": 419.8,
      "duration": 4.84,
      "text": "意見は市長に伝えてほしいということで それは伝えていただいていると思"
    },
    {
      "start": 424.64,
      "duration": 4.68,
      "text": "うんですがその際に丁寧に進めて もらいたいということは私から"
    },
    {
      "start": 429.32,
      "duration": 5.6,
      "text": "も言ったと思うんですが事前に うちの会派にも一切説明がなく"
    },
    {
      "start": 434.92,
      "duration": 5.2,
      "text": "今日迎えているんですがこの議運 に参加している会派で説明を受けた"
    },
    {
      "start": 440.12,
      "duration": 8.88,
      "text": "ところってあるんでしょうか事前 にないですかね説明今回の市長報告"
    },
    {
      "start": 449.0,
      "duration": 8.88,
      "text": "について市長報告の内容について なんだか説明があったのかどうか"
    },
    {
      "start": 457.88,
      "duration": 4.32,
      "text": "何もない片山さんはいあのうちの 会派にはありません一切ありません"
    },
    {
      "start": 462.2,
      "duration": 7.28,
      "text": "でした他はあったのかなかった のか一応聞いておきたいと思うん"
    },
    {
      "start": 469.48,
      "duration": 18.24,
      "text": "ですけどないなんかあったのかな っていうような"
    },
    {
      "start": 487.72,
      "duration": 3.0,
      "text": "いやあったのかなかったのか一応 ちょっと聞いておきたいなと思う"
    },
    {
      "start": 490.72,
      "duration": 6.72,
      "text": "けど何もなく今日のほら突然その 市長報告が配られて市長報告の"
    },
    {
      "start": 497.44,
      "duration": 4.6,
      "text": "本会議って形になっているので 本来であれば事前に何らか説明"
    },
    {
      "start": 502.04,
      "duration": 4.84,
      "text": "がね回られるっていうのが普通 かなと思ってそういうことを意識"
    },
    {
      "start": 506.88,
      "duration": 4.64,
      "text": "してその丁寧に進めてもらいたい って私は言ったつもりだったんですけ"
    },
    {
      "start": 511.52,
      "duration": 4.8,
      "text": "どだからないならないって言って もらえたらいいと思うんですあ"
    },
    {
      "start": 516.32,
      "duration": 7.84,
      "text": "あったならなんかあったでうん じゃあそれはちょっとわからない"
    },
    {
      "start": 524.16,
      "duration": 4.92,
      "text": "っていうことなのでだから結局 あれですかね説明があった会派"
    },
    {
      "start": 529.08,
      "duration": 5.28,
      "text": "もあったかもしれないということ になってくるとあのまあその辺"
    },
    {
      "start": 534.36,
      "duration": 4.8,
      "text": "ちょっと定かではないですけれども 事前に説明されたところが水谷"
    },
    {
      "start": 539.16,
      "duration": 6.76,
      "text": "さんどうぞはいあの先日会派で いろんな話があり今日のに失礼"
    },
    {
      "start": 545.92,
      "duration": 4.48,
      "text": "しました先日の会派代表者会議 で議会からのご意見ということで"
    },
    {
      "start": 550.4,
      "duration": 5.64,
      "text": "いろいろあり今日のこの日程になった と思っていますで市長報告をしたい"
    },
    {
      "start": 556.04,
      "duration": 5.48,
      "text": "という申出が市長の方からあった と当初想定していた日程はもう"
    },
    {
      "start": 561.52,
      "duration": 6.84,
      "text": "少し先であったというふうに私は 聞いていますで市長報告をお配り"
    },
    {
      "start": 568.36,
      "duration": 4.24,
      "text": "する前には各会派にそれぞれ説明 に回らせていただきたいという"
    },
    {
      "start": 572.6,
      "duration": 3.92,
      "text": "ふうに市長は考えていると私は 聞いておりましたけれども日程"
    },
    {
      "start": 576.52,
      "duration": 4.64,
      "text": "がそれより1週間早まったということ があり事前に各会派にそれぞれ"
    },
    {
      "start": 581.16,
      "duration": 4.6,
      "text": "お話をする時間が持てなかった ということだと思います私自身"
    },
    {
      "start": 585.76,
      "duration": 6.24,
      "text": "もそれはあのまあ遺憾に思うところ ではありますはい以上です"
    },
    {
      "start": 592.0,
      "duration": 4.8,
      "text": "じゃあとりあえずこの委員会では ここまでというあの要するにまあ"
    },
    {
      "start": 596.8,
      "duration": 3.12,
      "text": "どういう説明があったのかなかった のかっていうことについては"
    },
    {
      "start": 600.0,
      "duration": 5.12,
      "text": "何か市長に聞かなきゃよくわからないっていうのも もうおかしな話かなと思いますが"
    },
    {
      "start": 605.12,
      "duration": 6.44,
      "text": "ただ議事の進行上 ここでちょっと止まってるわけにいけませんので"
    },
    {
      "start": 611.56,
      "duration": 1.16,
      "text": "はい 片山さん"
    },
    {
      "start": 612.72,
      "duration": 5.28,
      "text": "あのですね やはり市長報告っていうのは 非常に重要な案件なものですから"
    },
    {
      "start": 618.0,
      "duration": 5.6,
      "text": "これまでもですね きちんと各会派に説明があるということが 当然かなと思います"
    },
    {
      "start": 623.6,
      "duration": 4.12,
      "text": "今日みたいに11時に配って それを1時からの会議でというのは"
    },
    {
      "start": 627.72,
      "duration": 5.88,
      "text": "ありえないなとふうには思ってますけれども それをですね 事前に説明があったかないかということを"
    },
    {
      "start": 633.6,
      "duration": 3.44,
      "text": "言えないような状態っていうのも ちょっとどういうことなのかと思いますので"
    },
    {
      "start": 637.04,
      "duration": 6.16,
      "text": "私たち子どもの権利情報公開の会派にはありませんでした ということは申し上げますけれども"
    },
    {
      "start": 643.2,
      "duration": 5.16,
      "text": "それさえも明らかにできないという状況は 一体何なのかなというふうに思います"
    },
    {
      "start": 648.36,
      "duration": 5.84,
      "text": "はい 他に皆さんからありますか"
    },
    {
      "start": 654.2,
      "duration": 6.6,
      "text": "よろしいですか あとは市長報告でちょっと 市長から発言いただくっていう形しか"
    },
    {
      "start": 660.8,
      "duration": 8.76,
      "text": "現時点では解明のしようがないっていう状況かなと それ自身もどうかなとは思いますが"
    },
    {
      "start": 669.56,
      "duration": 4.92,
      "text": "とりあえず議事の進行を進めたいと思います"
    },
    {
      "start": 674.48,
      "duration": 3.48,
      "text": "それでよろしいでしょうか 他"
    },
    {
      "start": 677.96,
      "duration": 2.04,
      "text": "はい じゃあ分かりだします"
    },
    {
      "start": 680.0,
      "duration": 4.84,
      "text": "本件については議長の諮問のとおり決定することに ご異議ありませんか"
    },
    {
      "start": 684.84,
      "duration": 2.88,
      "text": "ご異議なしと認めます したがって"
    },
    {
      "start": 687.72,
      "duration": 2.04,
      "text": "ご異議なし"
    },
    {
      "start": 689.76,
      "duration": 1.2,
      "text": "やむなし はい"
    },
    {
      "start": 690.96,
      "duration": 9.88,
