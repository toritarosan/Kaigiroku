{
  "video_id": "VmWlt3G9g2M",
  "entries": [
    {
      "start": 71.47,
      "duration": 5.0,
      "text": "お揃いですので理会運営委員会協議会を始めたいと思います"
    },
    {
      "start": 76.47,
      "duration": 6.0,
      "text": "最初に委員長報告後の討論採決なんですが討論ありますか"
    },
    {
      "start": 82.47,
      "duration": 6.85,
      "text": "かたやまさん"
    },
    {
      "start": 89.32,
      "duration": 4.0,
      "text": "八鎮上第15号"
    },
    {
      "start": 93.32,
      "duration": 3.0,
      "text": "賛成討論かたやまです"
    },
    {
      "start": 96.32,
      "duration": 2.48,
      "text": "他ありますか"
    },
    {
      "start": 98.8,
      "duration": 9.39,
      "text": "共産党は8陳上第21号に賛成討論対応です"
    },
    {
      "start": 108.19,
      "duration": 3.16,
      "text": "ということですいません"
    },
    {
      "start": 111.35,
      "duration": 4.52,
      "text": "あとは大丈夫でしょうか"
    },
    {
      "start": 115.87,
      "duration": 5.89,
      "text": "採決態度は従前どおりということでよろしいでしょうか"
    },
    {
      "start": 121.76,
      "duration": 3.48,
      "text": "協議事項はそれで大丈夫ですね"
    },
    {
      "start": 125.24,
      "duration": 2.76,
      "text": "あとは委員会の振興なんですが"
    },
    {
      "start": 128.0,
      "duration": 4.24,
      "text": "議長の諮問事項1件ということになっています"
    },
    {
      "start": 132.24,
      "duration": 4.76,
      "text": "議会運営に関する議長の諮問事項については"
    },
    {
      "start": 137.0,
      "duration": 2.68,
      "text": "市町送付案件の取扱いということで"
    },
    {
      "start": 139.68,
      "duration": 3.52,
      "text": "議案70号が送付されております"
    },
    {
      "start": 143.2,
      "duration": 3.6,
      "text": "取扱いについては本会議に上庭し"
    },
    {
      "start": 146.8,
      "duration": 3.0,
      "text": "説明し過ぎ委員会付託を省略し"
    },
    {
      "start": 149.8,
      "duration": 3.28,
      "text": "説明し過ぎ後委員会付託を省略し"
    },
    {
      "start": 153.08,
      "duration": 2.64,
      "text": "即決することについてということで"
    },
    {
      "start": 155.72,
      "duration": 2.36,
      "text": "お確認いただきたいと思います"
    },
    {
      "start": 158.08,
      "duration": 3.79,
      "text": "その他皆さんから何かありますか"
    },
    {
      "start": 161.87,
      "duration": 1.44,
      "text": "よろしいでしょうか"
    },
    {
      "start": 163.31,
      "duration": 6.59,
      "text": "はいじゃあお願いします"
    },
    {
      "start": 169.9,
      "duration": 3.2,
      "text": "ただ今から議会運営委員会の会議を開きます"
    },
    {
      "start": 173.1,
      "duration": 1.84,
      "text": "直ちに議事に入ります"
    },
    {
      "start": 174.94,
      "duration": 2.36,
      "text": "当委員会に付託されております案件は"
    },
    {
      "start": 177.3,
      "duration": 2.4,
      "text": "議長の諮問事項一件であります"
    },
    {
      "start": 179.7,
      "duration": 1.24,
      "text": "議長からお手元に"
    },
    {
      "start": 180.94,
      "duration": 3.92,
      "text": "議会運営委員会協議事項が提示されておりますので"
    },
    {
      "start": 184.86,
      "duration": 1.4,
      "text": "その順序に従って"
    },
    {
      "start": 186.26,
      "duration": 5.18,
      "text": "順次協議をしてまいりたいと思います 議会運営に関する議長の諮問事項について"
    },
    {
      "start": 191.44,
      "duration": 5.72,
      "text": "お伺いといたします 初めに協議事項1 市町送付案件の取り扱いについて"
    },
    {
      "start": 197.16,
      "duration": 3.7,
      "text": "行います 部局から発言があればお願いします"
    },
    {
      "start": 200.86,
      "duration": 6.17,
      "text": "総務長 追加送付案件についてご説明いたします"
    },
    {
      "start": 207.03,
      "duration": 6.48,
      "text": "8月26日付 議案第70号 小金江市小口事業資金有資圧線条例の"
    },
    {
      "start": 213.51,
      "duration": 3.56,
      "text": "一部を改正する条例を送付させていただきましたので"
    },
    {
      "start": 217.07,
      "duration": 2.88,
      "text": "取扱い方よろしくお願いいたします"
    },
    {
      "start": 219.95,
      "duration": 3.56,
      "text": "本件につきましては本会議での即決をお願いいたします"
    },
    {
      "start": 223.51,
      "duration": 5.72,
      "text": "なお本件につきまして本日差し替え文を送付させていただきました"
    },
    {
      "start": 229.23,
      "duration": 1.4,
      "text": "お手数をお掛けいたしまして"
    },
    {
      "start": 230.63,
      "duration": 3.83,
      "text": "申し訳ございませんがよろしくお願いいたします"
    },
    {
      "start": 234.46,
      "duration": 1.96,
      "text": "70です"
    },
    {
      "start": 236.42,
      "duration": 3.48,
      "text": "取扱いについて議長の諮問案が提示されておりますので"
    },
    {
      "start": 239.9,
      "duration": 1.16,
      "text": "説明をお願いします"
    },
    {
      "start": 241.06,
      "duration": 1.56,
      "text": "議長"
    },
    {
      "start": 242.62,
      "duration": 1.28,
      "text": "事務局から説明いたします"
    },
    {
      "start": 243.9,
      "duration": 12.48,
      "text": "議案第70号につきまして、本日の本会議に上庭し、説明・質疑後、委員会2個を省略し、即決したいというのが議長の諮問案でございます。"
    },
    {
      "start": 256.38,
      "duration": 5.0,
      "text": "議長及び事務局の説明を終わりました。ご意見、ご質疑とございますか。"
    },
    {
      "start": 261.38,
      "duration": 7.18,
      "text": "お諮りいたします。本件については、議長の諮問のとおり決定することにご意義ありませんか。"
    },
    {
      "start": 268.56,
      "duration": 5.19,
      "text": "ご意義なしと認めます。従って、本件は議長の諮問のとおり決定いたしました。"
    },
    {
      "start": 273.75,
      "duration": 4.7,
      "text": "協議事項確保にその他でございますが 何かご発言ございますか"
    },
    {
      "start": 278.45,
      "duration": 2.0,
      "text": "岸田さん"
    },
    {
      "start": 280.45,
      "duration": 4.3,
      "text": "はい 8月24日の議会運営委員会でも確認をしたのですが"
    },
    {
      "start": 284.75,
      "duration": 4.0,
      "text": "明確なご答弁いただけなかったので 再度確認いたします"
    },
    {
      "start": 288.75,
      "duration": 4.2,
      "text": "市長の追加送付案件はもうない という理解でよろしいでしょうか"
    },
    {
      "start": 292.95,
      "duration": 3.6,
      "text": "具体的には 庁舎建設にかける採摂差の予算の提出は"
    },
    {
      "start": 296.55,
      "duration": 2.67,
      "text": "あるのかないのかお願いします"
    },
    {
      "start": 299.22,
      "duration": 6.73,
      "text": "はい 総務長"
    },
    {
      "start": 305.95,
      "duration": 8.93,
      "text": "長者の採石算の補正予算にかかる案件の提出ですけれども、今回はございません"
    },
    {
      "start": 314.88,
      "duration": 2.0,
      "text": "吉田さん"
    },
    {
      "start": 316.88,
      "duration": 7.24,
      "text": "24日に確認したときには、何らご答弁いただけなかったわけですが、この間で何が変わったのでしょうか"
    },
    {
      "start": 324.12,
      "duration": 2.77,
      "text": "総務省"
    },
    {
      "start": 326.89,
      "duration": 4.0,
      "text": "私の方で聞いておりますのは、市長からですね"
    },
    {
      "start": 330.89,
      "duration": 3.0,
      "text": "議長をはじめとしまして、各会派の皆さんに"
    },
    {
      "start": 333.89,
      "duration": 5.5,
      "text": "ただいま申し上げました 庁舎の採積算の補正予算が出さないということと"
    },
    {
      "start": 339.39,
      "duration": 4.5,
      "text": "あと今後の進め方について 報告する必要があるということで"
    },
    {
      "start": 343.89,
      "duration": 4.93,
      "text": "今議長任候相談を申し上げているということで 聞いております"
    },
    {
      "start": 348.82,
      "duration": 3.0,
      "text": "【佐藤】岸田さん 質問と答弁が違いますね"
    },
    {
      "start": 351.82,
      "duration": 4.0,
      "text": "24日に確認したときには なんらお答えにならなかったのが"
    },
    {
      "start": 355.82,
      "duration": 2.0,
      "text": "今日はそのようにお答えいただいたというのは"
    },
    {
      "start": 357.82,
      "duration": 6.06,
      "text": "この3日間で一体何があったのでしょうか ということをお伺いしていますね"
    },
    {
      "start": 363.88,
      "duration": 5.0,
      "text": "【総務部長】宣奪手の定義がありまして"
    },
    {
      "start": 368.88,
      "duration": 3.0,
      "text": "その際に市長の方からそういうお話があったということでございます"
    },
    {
      "start": 371.88,
      "duration": 6.24,
      "text": "【市田】宣奪手の定義というのは昨日のことだと思っていますが"
    },
    {
      "start": 378.12,
      "duration": 2.0,
      "text": "その時も申し上げたんですが"
    },
    {
      "start": 380.12,
      "duration": 5.0,
      "text": "24日に定例会の日程を決める議会運営機会があることは"
    },
    {
      "start": 385.12,
      "duration": 2.0,
      "text": "ご承知だと思うんですよ"
    },
    {
      "start": 387.12,
      "duration": 2.0,
      "text": "その2日間で一体何が変わるんですか"
    },
    {
      "start": 389.12,
      "duration": 2.48,
      "text": "なんでそれより前にできないんですか"
    },
    {
      "start": 391.6,
      "duration": 5.52,
      "text": "総務長"
    },
    {
      "start": 397.12,
      "duration": 3.29,
      "text": "ちょっとこのことに関しましては"
    },
    {
      "start": 400.41,
      "duration": 3.0,
      "text": "私の方からお答えをおいたしかねますので"
    },
    {
      "start": 403.41,
      "duration": 2.0,
      "text": "すみません"
    },
    {
      "start": 405.41,
      "duration": 6.75,
      "text": "それは私の方では何とも言えないということになります"
    },
    {
      "start": 412.16,
      "duration": 2.87,
      "text": "岸田さん"
    },
    {
      "start": 415.03,
      "duration": 6.53,
      "text": "責任ある方のご答弁を求めたいと思います"
    },
    {
      "start": 421.56,
      "duration": 2.0,
      "text": "責任ある方"
    },
    {
      "start": 423.56,
      "duration": 4.38,
      "text": "総務長以外ではいらっしゃらないかな"
    },
    {
      "start": 427.94,
      "duration": 3.0,
      "text": "この委員会の場では"
    },
    {
      "start": 430.94,
      "duration": 13.22,
      "text": "ということなんですが、よろしいですか。"
    },
    {
      "start": 444.16,
      "duration": 4.0,
      "text": "はい、岸田さん、6問目になります。"
    },
    {
      "start": 448.16,
      "duration": 6.0,
      "text": "何も何もないと思うんで、あれなんですけど。"
    },
    {
      "start": 454.16,
      "duration": 6.38,
      "text": "その点が、その時にも申し上げたけれども、不正実だと申し上げているんですよ。"
    },
    {
      "start": 460.54,
      "duration": 3.0,
      "text": "これだけ大きな問題を。"
    },
    {
      "start": 463.54,
      "duration": 3.0,
      "text": "この2日間で何が変わるんですか、24日から26日で。"
    },
    {
      "start": 466.54,
      "duration": 3.86,
      "text": "その前にちゃんと設定してくださいよ"
    },
    {
      "start": 470.4,
      "duration": 4.74,
      "text": "町内の一視統一をする場を24日より前に設定して"
    },
    {
      "start": 475.14,
      "duration": 2.0,
      "text": "24日を迎えてそのようにするのが"
    },
    {
      "start": 477.14,
      "duration": 2.0,
      "text": "段取りなんじゃないですか"
    },
    {
      "start": 479.14,
      "duration": 3.32,
      "text": "段取り8部と言われていた市長ですから"
    },
    {
      "start": 482.46,
      "duration": 2.0,
      "text": "そうだと思うんですよ"
    },
    {
      "start": 484.46,
      "duration": 2.03,
      "text": "ついては今ご説明があったんですが"
    },
    {
      "start": 486.49,
      "duration": 1.0,
      "text": "ご説明になるものは"
    },
    {
      "start": 487.49,
      "duration": 3.0,
      "text": "いついかなる場を想定していらっしゃるんでしょうか"
    },
    {
      "start": 490.49,
      "duration": 3.83,
      "text": "総務長"
    },
    {
      "start": 494.32,
      "duration": 3.0,
      "text": "それについて先ほど申し上げましたとおり"
    },
    {
      "start": 497.32,
      "duration": 11.89,
      "text": "その通り市長から議長 各会派の方にご相談をしているというふうに聞いております"
    },
    {
      "start": 509.21,
      "duration": 2.0,
      "text": "【佐藤】岸田さんも"
    },
    {
      "start": 511.21,
      "duration": 6.0,
      "text": "【岸田】当会派に相談があったとは 具体的なお話は何も聞いてないですね"
    },
    {
      "start": 517.21,
      "duration": 5.86,
      "text": "議長の方には 市長からお話があったということでしょうか"
    },
    {
      "start": 523.07,
      "duration": 1.25,
      "text": "【佐藤】議長"
    },
    {
      "start": 524.32,
      "duration": 6.0,
      "text": "私の方には今回議員の皆さんから言われている"
    },
    {
      "start": 530.32,
      "duration": 6.0,
      "text": "蔡関さんの議案は提出しないということだけをお聞きして"
    },
    {
      "start": 536.32,
      "duration": 4.0,
      "text": "で、そのについて報告がしたいと"
    },
    {
      "start": 540.32,
      "duration": 5.35,
      "text": "議会のどこから報告したいというところまでお聞きしております"
    },
    {
      "start": 545.67,
      "duration": 1.0,
      "text": "はい、岸田さん"
    },
    {
      "start": 546.67,
      "duration": 2.0,
      "text": "はい、どういう形になるかというのは"
    },
    {
      "start": 548.67,
      "duration": 2.0,
      "text": "市長が大きめになることだと思いますが"
    },
    {
      "start": 550.67,
      "duration": 5.8,
      "text": "私は報告の前に説明を果たす義務があるというふうに考えております"
    },
    {
      "start": 556.47,
      "duration": 1.0,
      "text": "以上です"
    },
    {
      "start": 557.47,
      "duration": 6.66,
      "text": "はい ということで 他に皆さんから何かありますか"
    },
    {
      "start": 564.13,
      "duration": 1.0,
      "text": "はい 坂井さん"
    },
    {
      "start": 565.13,
      "duration": 2.0,
      "text": "すいません 今のに絡んでというか"
    },
    {
      "start": 567.13,
      "duration": 5.0,
      "text": "私も岸田さんがおっしゃっているように議会日程が分かっている中で"
    },
    {
      "start": 572.13,
      "duration": 6.0,
      "text": "逆算して長期で意思統一を図っていただきたかということはずっと申し上げておきますというのと"
    },
    {
      "start": 578.13,
      "duration": 5.5,
      "text": "あと、議長には今、議案が出ないと聞いたということと、報告したいということで、"
    },
    {
      "start": 583.63,
      "duration": 6.0,
      "text": "報告する場がどこなのか、未だ不明確であるのかなということと思うんですね。"
    },
    {
      "start": 589.63,
      "duration": 4.5,
      "text": "一議的に言うと、特別委員会を議会は設置しておりますので、"
    },
    {
      "start": 594.13,
      "duration": 3.0,
      "text": "一議的には特別委員会になるかと思いますが、"
    },
    {
      "start": 597.13,
      "duration": 2.5,
      "text": "それ以上の何かご判断があるのであれば、"
    },
    {
      "start": 599.63,
      "duration": 6.0,
      "text": "そこの場の報告では収まらない場合も、私は想定されると思っておりまして、"
    },
    {
      "start": 605.63,
      "duration": 4.0,
      "text": "どこの場ということについても確認なんですが"
    },
    {
      "start": 609.63,
      "duration": 3.0,
      "text": "議長は相談を受けておらず報告したいというレベルなのか"
    },
    {
      "start": 612.63,
      "duration": 2.0,
      "text": "議会日程も決めておりますので"
    },
    {
      "start": 614.63,
      "duration": 4.0,
      "text": "これから定例会の済むにあたっての心済むれというか"
    },
    {
      "start": 618.63,
      "duration": 2.0,
      "text": "議会日程にも影響することなので"
    },
    {
      "start": 620.63,
      "duration": 2.0,
      "text": "今一度報告のレベルについて"
    },
    {
      "start": 622.63,
      "duration": 2.0,
      "text": "ご相談はなかったのかということについて"
    },
    {
      "start": 624.63,
      "duration": 4.59,
      "text": "聞かせていただきたいです"
    },
    {
      "start": 629.22,
      "duration": 12.12,
      "text": "そういうご報告、相談といいますか、があったときに、いわゆるとすればですね、"
    },
    {
      "start": 641.34,
      "duration": 12.0,
      "text": "4日目の本会議においてですね、ご報告いただけるというのが順当かなというふうに思っております。"
    },
    {
      "start": 653.34,
      "duration": 14.27,
      "text": "4日目とおっしゃるとおり、いっぱい質問が終わった後の本会議が一体何時に始まるのかということと、"
    },
    {
      "start": 667.61,
      "duration": 6.0,
      "text": "一応議会は提示を持っておりますけれども、そこで収められる程度のご報告なのか、"
    },
    {
      "start": 673.61,
      "duration": 5.0,
      "text": "市長の腹積もりが分かりませんけれども、その時間から始めるということについては、"
    },
    {
      "start": 678.61,
      "duration": 3.0,
      "text": "大いに懸念があるということは申し上げておきます。"
    },
    {
      "start": 681.61,
      "duration": 5.0,
      "text": "そんなに長くならないような合理的な説明をいただけることかなと思いますので"
    },
    {
      "start": 686.61,
      "duration": 8.53,
      "text": "どうなるか分かりませんがそのような方向性であることは聞き起きました"
    },
    {
      "start": 695.14,
      "duration": 3.32,
      "text": "他にありますか"
    },
    {
      "start": 698.46,
      "duration": 4.47,
      "text": "川野さん"
    },
    {
      "start": 702.93,
      "duration": 7.0,
      "text": "本件につきましては8月21日でしたでしょうか議案説明の際にですね"
    },
    {
      "start": 709.93,
      "duration": 8.0,
      "text": "私の方からは、出すにせよ、出さないにせよ、丁寧なご説明をお願いしたいと言ったことは申し上げておりました。"
    },
    {
      "start": 717.93,
      "duration": 12.0,
      "text": "おそらく機材部長はもちろん聞いていらっしゃいましたし、後ろで庁舎建設と担当部長も聞いていらっしゃいましたので、その間ご説明いただけるものかなと思っておりましたが、"
    },
    {
      "start": 729.93,
      "duration": 10.0,
      "text": "我が会派としましては、この件について、丁寧ではなかったですが、情報についてお話を伺ったのが、昨日の夕方のことであります。"
    },
    {
      "start": 739.93,
      "duration": 5.0,
      "text": "こういったご対応というのは少し残念かなという印象は持っております。"
    },
    {
      "start": 744.93,
      "duration": 6.0,
      "text": "あえて丁寧に説明してほしいということは申し上げておりましたので、ということは申しておきます。"
    },
    {
      "start": 750.93,
      "duration": 13.0,
      "text": "また、どういった報告になるかわからないといった中で、9月7日の一般質問号が最有力ではないかというところで、4社でも話は少ししたところではございますが、"
    },
    {
      "start": 763.93,
      "duration": 8.0,
      "text": "この議会、まだ小さいお子さん抱えた方もいらっしゃるようなところはありますので、私も子供がおりますので、"
    },
    {
      "start": 771.93,
      "duration": 7.0,
      "text": "そういったところも少しご配慮いただいての日程設定をしていただければ、都市庁の報告にはお願いしたいと思います。"
    },
    {
      "start": 778.93,
      "duration": 2.61,
      "text": "以上です"
    },
    {
      "start": 781.54,
      "duration": 3.98,
      "text": "ほかにありますか"
    },
    {
      "start": 785.52,
      "duration": 2.0,
      "text": "委員会で立たれた意見については"
    },
    {
      "start": 787.52,
      "duration": 2.0,
      "text": "市長の方にぜひお伝えいただいて"
    },
    {
      "start": 789.52,
      "duration": 4.0,
      "text": "事前に丁寧な説明していただくように"
    },
    {
      "start": 793.52,
      "duration": 3.0,
      "text": "お願いしておきたいと思います"
    },
    {
      "start": 796.52,
      "duration": 3.0,
      "text": "皆さんからは以上でよろしいでしょうか"
    },
    {
      "start": 799.52,
      "duration": 2.83,
      "text": "はい"
    },
    {
      "start": 802.35,
      "duration": 2.0,
      "text": "それで"
    },
    {
      "start": 804.35,
      "duration": 2.0,
      "text": "これはその他だったよね"
    },
    {
      "start": 806.35,
      "duration": 2.0,
      "text": "以上で議会運営に関する議長の"
    },
    {
      "start": 808.35,
