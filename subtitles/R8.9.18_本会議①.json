    },
    {
      "start": 1617.97,
      "duration": 3.63,
      "text": "恐れ入りますが 議案1ページ目にお戻りください"
    },
    {
      "start": 1621.6,
      "duration": 4.75,
      "text": "交番3の契約金額でございます"
    },
    {
      "start": 1626.35,
      "duration": 5.36,
      "text": "落札金額9,780万円に消費税及び地方消費税"
    },
    {
      "start": 1631.71,
      "duration": 7.27,
      "text": "978万円を加えました 1億飛び758万円になります"
    },
    {
      "start": 1638.98,
      "duration": 6.94,
      "text": "交番4 契約の相手型につきましては 東京都八王子市 中野上町二丁目31番1号"
    },
    {
      "start": 1645.92,
      "duration": 6.62,
      "text": "日本機械工業株式会社代表取締役 北橋明彦でございます"
    },
    {
      "start": 1652.54,
      "duration": 7.76,
      "text": "最後に交番の5 契約期間は 契約の確定日から令和10年3月31日までとなります"
    },
    {
      "start": 1660.3,
      "duration": 6.13,
      "text": "説明につきましては以上でございます よろしく御審議の上 ご意決断もありますようお願い申し上げます"
    },
    {
      "start": 1666.43,
      "duration": 5.99,
      "text": "質疑を行います 質疑を終了することにご意見はありませんか"
    },
    {
      "start": 1672.42,
      "duration": 3.0,
      "text": "ご意見なしと認め 質疑を終了します"
    },
    {
      "start": 1675.42,
      "duration": 3.56,
      "text": "お分かりします 本件は委員会付託を省略し"
    },
    {
      "start": 1678.98,
      "duration": 3.6,
      "text": "討論採決を一時保留することにご意見はありませんか"
    },
    {
      "start": 1682.58,
      "duration": 3.52,
      "text": "ご意見なしと認め 本件は委員会付託を省略し"
    },
    {
      "start": 1686.1,
      "duration": 5.54,
      "text": "討論採決を一時保留することと決定しました"
    },
    {
      "start": 1691.64,
      "duration": 3.78,
      "text": "日程第19 議案第72号"
    },
    {
      "start": 1695.42,
      "duration": 6.88,
      "text": "小金井市会計年度任用職員の報酬に関する 条例の一部を改正する条例を議題とします"
    },
    {
      "start": 1702.3,
      "duration": 6.44,
      "text": "議案 提案理由の説明を求めます 市長"
    },
    {
      "start": 1708.74,
      "duration": 5.0,
      "text": "議案第72号 小金井市会計年度任用職員の報酬等に関する条例の一部を"
    },
    {
      "start": 1713.74,
      "duration": 2.92,
      "text": "改正する条例を御提案申し上げます"
    },
    {
      "start": 1716.66,
      "duration": 2.52,
      "text": "東京都最低賃金の引上げ等に鑑み"
    },
    {
      "start": 1719.18,
      "duration": 5.4,
      "text": "会計年度任用職員の報酬時間額を改正するため 法案を提出するものであります"
    },
    {
      "start": 1724.58,
      "duration": 3.2,
      "text": "細部につきましては 担当部長から説明させていただきますので"
    },
    {
      "start": 1727.78,
      "duration": 4.82,
      "text": "よろしくご審議の上 ご意見を伝わりますよう お願い申し上げます"
    },
    {
      "start": 1732.6,
      "duration": 2.28,
      "text": "総務部長"
    },
    {
      "start": 1734.88,
      "duration": 3.18,
      "text": "細部についてご説明いたします"
    },
    {
      "start": 1738.06,
      "duration": 5.28,
      "text": "令和8年9月1日に 東京都最低賃金額を"
    },
    {
      "start": 1743.34,
      "duration": 10.36,
      "text": "時間額1226円から54円引き上げ 1280円に改正する決定が講じされたこと等に鑑み"
    },
    {
      "start": 1753.7,
      "duration": 6.13,
      "text": "本市の会計年度任用職員の報酬時間額を 改正するものでございます"
    },
    {
      "start": 1759.83,
      "duration": 5.93,
      "text": "議案第72号 資料1 新旧対象表をご覧ください"
    },
    {
      "start": 1765.76,
      "duration": 6.0,
      "text": "会計年度任用職員の職種及び報酬時間額を 定めております別表につきまして"
    },
    {
      "start": 1771.76,
      "duration": 5.48,
      "text": "各職種の1時間あたりの報酬時間額を 改めるものでございます"
    },
    {
      "start": 1777.24,
      "duration": 4.0,
      "text": "報酬時間額改正の方針としまして"
    },
    {
      "start": 1781.24,
      "duration": 6.38,
      "text": "一般事務 学童保育士同員補助及び 経作業 業務等については"
    },
    {
      "start": 1787.62,
      "duration": 4.3,
      "text": "最低賃金額以上の金額とするため 50円を増額し"
    },
    {
      "start": 1791.92,
      "duration": 3.68,
      "text": "その他の職種についても 処遇改善の観点から"
    },
    {
      "start": 1795.6,
      "duration": 4.38,
      "text": "一律50円の増額を行うことを 基本としております"
    },
    {
      "start": 1799.98,
      "duration": 2.6,
      "text": "ただし他市との均衡を考慮し"
    },
    {
      "start": 1802.58,
      "duration": 7.48,
      "text": "たま26市の平均を100円以上下回る職種については 100円の増額"
    },
    {
      "start": 1810.06,
      "duration": 7.04,
      "text": "逆に26市平均を100円以上上回る職種については 末置きとして検討いたしましたが"
    },
    {
      "start": 1817.1,
      "duration": 6.68,
      "text": "全職種100円未満の介理でありましたことから 一律50円の増額としたものでございます"
    },
    {
      "start": 1823.78,
      "duration": 6.5,
      "text": "詳細は議案資料1をご覧ください 次に不足でございます"
    },
    {
      "start": 1830.28,
      "duration": 9.77,
      "text": "この条例は東京都最低賃金の決定の効力が生じる 令和8年10月1日から施行するものでございます"
    },
    {
      "start": 1840.05,
      "duration": 4.73,
      "text": "1枚おめくりいただきまして 議案資料2をご覧ください"
    },
    {
      "start": 1844.78,
      "duration": 3.2,
      "text": "多摩26市の状況でございます"
    },
    {
      "start": 1847.98,
      "duration": 2.16,
      "text": "交番の1は改正前"
    },
    {
      "start": 1850.14,
      "duration": 3.64,
      "text": "令和8年4月1日現在の会計年度任用職員"
    },
    {
      "start": 1853.78,
      "duration": 3.36,
      "text": "一般事務職の報酬時間額の状況"
    },
    {
      "start": 1857.14,
      "duration": 2.68,
      "text": "交番の2は最低賃金を下回る"
    },
    {
      "start": 1859.82,
      "duration": 5.01,
      "text": "20市の現時点での報酬時間額 改正予定額でございます"
    },
    {
      "start": 1864.83,
      "duration": 4.83,
      "text": "理面になります 議案資料3をご覧ください"
    },
    {
      "start": 1869.66,
      "duration": 8.5,
      "text": "現行及び改正後の職種ごとの1時間あたりの報酬時間額について26市平均と比較したものでございます"
    },
    {
      "start": 1878.16,
      "duration": 8.0,
      "text": "なお本改正による影響額でございますが令和8年10月から令和9年3月までの6ヶ月間で"
    },
    {
      "start": 1886.16,
      "duration": 6.86,
      "text": "約1000トンで50万円年間では約2100万円の増額と試算をしております"
    },
    {
      "start": 1893.02,
      "duration": 5.54,
      "text": "以上で説明を終わりますよろしくご審議の上ご意見を伝わりますようよろしくお願い申し上げます"
    },
    {
      "start": 1898.56,
      "duration": 5.88,
      "text": "質疑を行います 片山さん"
    },
    {
      "start": 1904.44,
      "duration": 6.14,
      "text": "はい この会計年度任用職員の報酬の条例については"
    },
    {
      "start": 1910.58,
      "duration": 4.6,
      "text": "反対するわけではなくて 応援に賛成するところではあるんですが"
    },
    {
      "start": 1915.18,
      "duration": 3.48,
      "text": "確認をしたいものですから 質疑をさせていただきます"
    },
    {
      "start": 1918.66,
      "duration": 8.04,
      "text": "この中でですね この職種として"
    },
    {
      "start": 1926.7,
      "duration": 5.84,
      "text": "資料の3にありますところの職種としてあるところで"
    },
    {
      "start": 1932.54,
      "duration": 3.64,
      "text": "まだですね 今 かなり募集がかかっている"
    },
    {
      "start": 1936.18,
      "duration": 2.92,
      "text": "応募がないような職種があるとは思うんですが"
    },
    {
      "start": 1939.1,
      "duration": 3.04,
      "text": "特にですね 保育士とか保育士補助"
    },
    {
      "start": 1942.14,
      "duration": 3.96,
      "text": "また学童保育士動員 学童保育士動員補助については"
    },
    {
      "start": 1946.1,
      "duration": 4.32,
      "text": "どのぐらいですね この応募がないような状態"
    },
    {
      "start": 1950.42,
      "duration": 1.96,
      "text": "血院状態になっているか"
    },
    {
      "start": 1952.38,
      "duration": 2.24,
      "text": "ということを確認したいと思います"
    },
    {
      "start": 1954.62,
      "duration": 5.88,
      "text": "そしてその決意の状況をどのようにして改善していくのか"
    },
    {
      "start": 1960.5,
      "duration": 4.28,
      "text": "このような形で報酬単価を上げたということで"
    },
    {
      "start": 1964.78,
      "duration": 3.16,
      "text": "解決するような問題なのかどうかという認識について"
    },
    {
      "start": 1967.94,
      "duration": 2.4,
      "text": "お伺いしておきたいと思います"
    },
    {
      "start": 1970.34,
      "duration": 6.28,
      "text": "根本的に本来はこれらの職種については"
    },
    {
      "start": 1976.62,
      "duration": 3.64,
      "text": "これまでもかなり報酬がずっとかかっていて"
    },
    {
      "start": 1980.26,
      "duration": 3.0,
      "text": "もう応募がないという状況が続いているかと思います"
    },
    {
      "start": 1983.26,
      "duration": 5.0,
      "text": "それを解消するための策については 検討されているのかどうか"
    },
    {
      "start": 1988.26,
      "duration": 4.72,
      "text": "ということについてを確認したいと思います"
    },
    {
      "start": 1992.98,
      "duration": 3.36,
      "text": "職員課長"
    },
    {
      "start": 1996.34,
      "duration": 5.64,
      "text": "それではまず保育士保育士補助 学童保育指導員補助の"
    },
    {
      "start": 2001.98,
      "duration": 3.9,
      "text": "結院状況についてでございます"
    },
    {
      "start": 2005.88,
      "duration": 3.42,
      "text": "時給制ですので 時点時点で異なるものですが"
    },
    {
      "start": 2009.3,
      "duration": 3.54,
      "text": "9月1日時点での結院状況が"
    },
    {
      "start": 2012.84,
      "duration": 6.08,
      "text": "保育士が61人中36人 保育補助が72人中34人"
    },
    {
      "start": 2018.92,
      "duration": 5.4,
      "text": "学童保育指導員が31人中8人 学童指導員補助が5人中1人"
    },
    {
      "start": 2024.32,
      "duration": 2.16,
      "text": "ということになっております"
    },
    {
      "start": 2026.48,
      "duration": 5.72,
      "text": "また 血院状況の改善ということについてです"
    },
    {
      "start": 2032.2,
      "duration": 5.0,
      "text": "時給制で任用している会計年度の雇用につきましても"
    },
    {
      "start": 2037.2,
      "duration": 4.84,
      "text": "指定した人員の確保に苦慮して 血院が所持てるような現状については"
    },
    {
      "start": 2042.04,
      "duration": 12.4,
      "text": "大変重く受け止めておりまして 記念 保育ですとか 児童学堂の指導員の人材の不足と"
    },
    {
      "start": 2054.44,
      "duration": 5.5,
      "text": "社会情勢も影響している面があるのかなとは考えておりますが"
    },
    {
      "start": 2059.94,
      "duration": 4.7,
      "text": "採用担当といたしましては 例えばホームページの掲載用ですとか"
    },
    {
      "start": 2064.64,
      "duration": 6.76,
      "text": "あとは広告掲載 ポスターなど工夫して 作成する等の対応を図って"
    },
    {
      "start": 2071.4,
      "duration": 4.88,
      "text": "雇用ができるよう努めているところでございます"
    },
    {
      "start": 2076.28,
      "duration": 5.76,
      "text": "また根本的な解決というところについても お話いただきましたが"
    },
    {
      "start": 2082.04,
      "duration": 6.52,
      "text": "根本的にということになりますと 関係家との調整も必要になりますことから"
    },
    {
      "start": 2088.56,
      "duration": 6.2,
      "text": "そこについては 本日については 今後の検討課題ということになろうかと思っております"
    },
    {
      "start": 2094.76,
      "duration": 2.02,
      "text": "以上です"
    },
    {
      "start": 2096.78,
      "duration": 1.94,
      "text": "片山さん"
    },
    {
      "start": 2098.72,
      "duration": 4.2,
      "text": "はい このですね 結院状態については"
    },
    {
      "start": 2102.92,
      "duration": 6.1,
      "text": "かなり保育士などについては 61人必要だというところが"
    },
    {
      "start": 2109.02,
      "duration": 4.2,
      "text": "36人の結院があるというような 大変これですね"
    },
    {
      "start": 2113.22,
      "duration": 1.9,
      "text": "大きな問題だと思います"
    },
    {
      "start": 2115.12,
      "duration": 11.2,
      "text": "時間制ですので、単人とかそういうことじゃないかと思いますけれども、朝とか夕方とした時間ということもあるかと思いますけれども、"
    },
    {
      "start": 2126.32,
      "duration": 5.8,
      "text": "そちらがもしいないとすれば、誰かが固定しなきゃいけないわけですね。"
    },
    {
      "start": 2132.12,
      "duration": 8.8,
      "text": "現在、保育園の状況は一体どうなっているんでしょうか。保育園の園長さんは皆さんご縁ともいらっしゃるんですか。"
    },
    {
      "start": 2140.92,
      "duration": 2.5,
      "text": "ちょっとそちらについて確認したいと思います"
    },
    {
      "start": 2143.42,
      "duration": 4.2,
      "text": "誰かですね お休みされてるというようなこともお聞きしてるわけですけれども"
    },
    {
      "start": 2147.62,
      "duration": 3.5,
      "text": "正規職員の状態はどのような状況なんでしょうか"
    },
    {
      "start": 2151.12,
      "duration": 5.6,
      "text": "で この36人ですね 決意がいないところをどのように補正してるかということは"
    },
    {
      "start": 2156.72,
      "duration": 4.2,
      "text": "これはですね 職員会の方では把握されてるんでしょうか"
    },
    {
      "start": 2160.92,
      "duration": 4.7,
      "text": "これはやっぱりですね 担当課だけに任せていくんじゃなくて"
    },
    {
      "start": 2165.62,
      "duration": 3.8,
      "text": "これが補充できてなかったということについては"
    },
    {
      "start": 2169.42,
      "duration": 8.0,
      "text": "これはどのような状況にあるか 担当課の方で どういった困っている状態にあるかを把握して"
    },
    {
      "start": 2177.42,
      "duration": 3.0,
      "text": "それをですね 速やかに解決すべきだと思うわけですよ"
    },
    {
      "start": 2180.42,
      "duration": 6.0,
      "text": "ですので先ほど根本的な解決策については 検討していないのかということをお聞きしているわけです"
    },
    {
      "start": 2186.42,
      "duration": 4.0,
      "text": "これは職員課だけがですね 対応するものではないんですが"
    },
    {
      "start": 2190.42,
      "duration": 3.0,
      "text": "こうやって採用の募集をかけるだけではなくて"
    },
    {
      "start": 2193.42,
      "duration": 5.0,
      "text": "ここで募集がかけても応募がなかった場合 これはずっと続いてるじゃないですか"
    },
    {
      "start": 2198.42,
      "duration": 12.0,
      "text": "こういった状態についてを、そもそも何が問題なのか、他の自治体ではどういった状況なのかを把握して、解決方法をしっかりと提示していく。"
    },
    {
      "start": 2210.42,
      "duration": 10.0,
      "text": "それを全体的に検討すべきだということと考えますが、どのようにお考えなのかお聞かせいただきたいと思います。"
    },
    {
      "start": 2220.42,
      "duration": 5.22,
      "text": "他の自治体での状況を是非確認いただきたいですね"
    },
    {
      "start": 2225.64,
      "duration": 7.49,
      "text": "例えば正規職員がきちんとしっかりと配置されていて"
    },
    {
      "start": 2233.13,
      "duration": 7.13,
      "text": "会計年度の配置が少ないとか いろんな状態があると思います"
    },
    {
      "start": 2240.26,
      "duration": 2.58,
      "text": "そういった状況を把握しながら"
    },
    {
      "start": 2242.84,
      "duration": 5.6,
      "text": "なぜここが年でこうやって 血縁が出てしまうのかということについて"
    },
    {
      "start": 2248.44,
      "duration": 3.0,
      "text": "これについてどういった分析をしていくのかを"
    },
    {
      "start": 2251.44,
      "duration": 3.0,
      "text": "考えていただきたいと思っております"
    },
    {
      "start": 2254.44,
      "duration": 3.96,
      "text": "そしてですね"
    },
    {
      "start": 2258.4,
      "duration": 3.0,
      "text": "この"
    },
    {
      "start": 2261.4,
      "duration": 3.0,
      "text": "とりあえずその件についてお伺いしたいと思います"
    },
    {
      "start": 2264.4,
      "duration": 7.13,
      "text": "職員課長"
    },
    {
      "start": 2271.53,
      "duration": 4.0,
      "text": "保育士の自給生の方の決意について"
    },
    {
      "start": 2275.53,
      "duration": 5.0,
      "text": "保育園の状況どう補填しているか等の把握についてでございます"
    },
    {
      "start": 2280.53,
      "duration": 4.0,
      "text": "詳細はやはり現場での対応と考えておりますので"
    },
    {
      "start": 2284.53,
      "duration": 4.4,
      "text": "細かいところは把握できてないところですが"
    },
    {
      "start": 2288.93,
      "duration": 4.0,
      "text": "随時所属庁とは先ほどお話のあった保育園の"
    },
    {
      "start": 2292.93,
      "duration": 2.2,
      "text": "援助の体制等も共有し"
    },
    {
      "start": 2295.13,
      "duration": 2.6,
      "text": "できる対応を図っているところです"
    },
    {
      "start": 2297.73,
      "duration": 2.0,
      "text": "多市状況につきましては"
    },
    {
      "start": 2299.73,
      "duration": 5.2,
      "text": "専門職の人材確保に苦慮しているような状況は"
    },
    {
      "start": 2304.93,
      "duration": 3.0,
      "text": "職員化としては聞いているところでして"
    },
    {
      "start": 2307.93,
      "duration": 17.23,
      "text": "細かい体制については、やはり各種の勤務時間でしたり、体制のところ、また時給については時点時点で状況が異なるものなので、把握は難しいのかなというふうには捉えております。以上です。"
    },
    {
      "start": 2325.16,
      "duration": 4.08,
      "text": "【佐藤】片山さん。"
    },
    {
      "start": 2329.24,
      "duration": 8.0,
      "text": "【片山】ちょっと答えがなかった部分があると思うんですが、各保育園がですね、公立保育園がね、まだ5園あるわけですけれども、"
    },
    {
      "start": 2337.24,
      "duration": 5.0,
      "text": "保育園の園長さんは今いらっしゃるような状態なんでしょうか"
    },
    {
      "start": 2342.24,
      "duration": 4.0,
      "text": "お休みされている方もいらっしゃるというようなことを聞きしているわけですけれども"
    },
    {
      "start": 2346.24,
      "duration": 3.0,
      "text": "どういった状況なのかを確認したいと思っております"
    },
    {
      "start": 2349.24,
      "duration": 6.0,
      "text": "その上で正規職員が補填をされている状況なのかどうかということについては"
    },
    {
      "start": 2355.24,
      "duration": 4.0,
      "text": "これはきちんと把握はできていないということなんでしょうかね"
    },
    {
      "start": 2359.24,
      "duration": 2.0,
      "text": "ちょっと確認したいと思います"
    },
    {
      "start": 2361.24,
      "duration": 3.0,
      "text": "これは実級ということではあるんですけれども"
    },
    {
      "start": 2364.24,
      "duration": 5.0,
      "text": "やはり必要だから募集かけてるわけですよね"
    },
    {
      "start": 2369.24,
      "duration": 4.0,
      "text": "結院について36人も結院があるというところについて"
    },
    {
      "start": 2373.24,
      "duration": 4.0,
      "text": "保育士ですね、保育士補助は34人の結院"
    },
    {
      "start": 2377.24,
      "duration": 3.0,
      "text": "このような状況がある中で"
    },
    {
      "start": 2380.24,
      "duration": 4.0,
      "text": "正規職員がどのようにここを保管しているのか"
    },
    {
      "start": 2384.24,
      "duration": 4.0,
      "text": "正規職員じゃないところでですね"
    },
    {
      "start": 2388.24,
      "duration": 5.8,
      "text": "研究生の会計念頭、医療職員などが何か補填しているかもしれませんけれども"
    },
    {
      "start": 2394.04,
      "duration": 3.68,
      "text": "そのような細かい状況の把握については"
    },
    {
      "start": 2397.72,
      "duration": 3.64,
      "text": "これはですね誰が責任を持って把握していくんでしょうか"
    },
    {
      "start": 2401.36,
      "duration": 2.44,
      "text": "所属庁ということではあるんですけれども"
    },
    {
      "start": 2403.8,
      "duration": 2.76,
      "text": "これをですねやっぱり募集をかける際に"
    },
    {
      "start": 2406.56,
      "duration": 6.36,
      "text": "今回この時給単価の増額という形だけしか"
    },
    {
      "start": 2412.92,
      "duration": 3.32,
      "text": "この条例では決めてないわけですけれども"
    },
    {
      "start": 2416.24,
      "duration": 3.36,
      "text": "こういった時給をただ上げるとかですね"
    },
    {
      "start": 2419.6,
      "duration": 6.64,
      "text": "それで募集をまたすればいいというような問題ではないというようなことに"
    },
    {
      "start": 2426.24,
      "duration": 3.28,
      "text": "今落ち入っているのではないかということから言ってもですね"
    },
    {
      "start": 2429.52,
      "duration": 2.56,
      "text": "やっぱり抜本的に何が問題で"
    },
    {
      "start": 2432.08,
      "duration": 3.4,
      "text": "どのように解決していったらいいのかということを合わせながら"
    },
    {
      "start": 2435.48,
      "duration": 2.36,
      "text": "こういった条例の提案をすべきではないかと"
    },
    {
      "start": 2437.84,
      "duration": 2.86,
      "text": "考えますがいかがでしょうか"
    },
    {
      "start": 2440.7,
      "duration": 2.2,
      "text": "子ども家庭部長"
    },
    {
      "start": 2442.9,
      "duration": 3.6,
      "text": "公立園の園長の配置についてご質問いただきました"
    },
    {
      "start": 2446.5,
      "duration": 5.94,
      "text": "5円につきましては5箇所 延長は適切に配置されているところでございます"
    },
    {
      "start": 2452.44,
      "duration": 5.26,
      "text": "で 議員の方からお休み お休みの指摘等ございましたけど"
    },
    {
      "start": 2457.7,
      "duration": 4.76,
      "text": "年間の中でお休みになる いろんな自由であることはございますけど"
    },
    {
      "start": 2462.46,
      "duration": 9.5,
      "text": "今この場でどこの円がお休みになっているというのは ちょっと答弁を控えさせていただきます"
    },
    {
      "start": 2471.96,
      "duration": 2.4,
      "text": "職員課長"
    },
    {
      "start": 2474.36,
      "duration": 10.56,
      "text": "現場の決意の補填の状況等について採用担当としても 状況の把握をというような"
    },
    {
      "start": 2484.92,
      "duration": 2.9,
      "text": "ご質問ご意見をいただいているところです"
    },
    {
      "start": 2487.82,
      "duration": 7.3,
      "text": "先ほど申し上げたとおり 一義的には所属庁での状況の対応ということになろうかと思いますが"
    },
    {
      "start": 2495.12,
      "duration": 5.04,
      "text": "採用担当といたしましてもその状況の把握 所属庁との共有"
    },
    {
      "start": 2500.16,
      "duration": 5.84,
      "text": "あとどのような対応ができるか 引き続き共有しながら対応するつもりではございます"
    },
    {
      "start": 2506.0,
      "duration": 6.04,
      "text": "以上です"
    },
    {
      "start": 2512.04,
      "duration": 4.95,
      "text": "他にございますか 森戸さん"
    },
    {
      "start": 2516.99,
      "duration": 7.88,
      "text": "一つは今回最低賃金のアップに 基づいてあげるということには"
    },
    {
      "start": 2524.87,
      "duration": 10.51,
      "text": "私たちとしても賛成ではありますが 各市との比較を見ると"
    },
    {
      "start": 2535.38,
      "duration": 5.52,
      "text": "平均以下という職種がかなりあるわけですよね"
    },
    {
      "start": 2540.9,
      "duration": 2.8,
      "text": "少なくともですね"
    },
    {
      "start": 2543.7,
      "duration": 3.56,
      "text": "たま平均まで持っていかないと"
    },
    {
      "start": 2547.26,
      "duration": 3.8,
      "text": "なかなか人材を確保するということは"
    },
    {
      "start": 2551.06,
      "duration": 4.88,
      "text": "難しいのではないかというふうに思っています"
    },
    {
      "start": 2555.94,
      "duration": 1.68,
      "text": "今回ですね"
    },
    {
      "start": 2557.62,
      "duration": 6.64,
      "text": "毎回最低賃金のアップに合わせての話ではあるんですが"
    },
    {
      "start": 2564.26,
      "duration": 6.48,
      "text": "この玉地域との格差を是正するということは"
    },
    {
      "start": 2570.74,
      "duration": 3.08,
      "text": "今回の提案の中では考えなかったのか"
    },
    {
      "start": 2573.82,
      "duration": 2.68,
      "text": "また来年も多分ね"
    },
    {
      "start": 2576.5,
      "duration": 3.24,
      "text": "最低賃金が上がるとは思うんですが"
    },
    {
      "start": 2579.74,
      "duration": 4.8,
      "text": "やっぱり玉平均までですね"
    },
    {
      "start": 2584.54,
      "duration": 4.24,
      "text": "全職種引き上げるべきではないかと思いますが"
    },
    {
      "start": 2588.78,
      "duration": 5.4,
      "text": "その点について確認をさせてください"
    },
    {
      "start": 2594.18,
      "duration": 16.03,
      "text": "職員課長 今回ご提案している多摩26市の平均との比較というところで"
    },
    {
      "start": 2610.21,
      "duration": 7.0,
      "text": "少なくとも平均までというようなご意見をいただいたところです"
    },
    {
      "start": 2617.21,
      "duration": 9.0,
      "text": "そのような引上げの考えももちろんそのような意見があるということは受け止めつつというところではございますが"
    },
    {
      "start": 2626.21,
      "duration": 7.0,
      "text": "市の方針としてやはり、会計年度任用職員、一般職の地方公務員であるということと、"
    },
    {
      "start": 2633.21,
      "duration": 8.0,
      "text": "あと、情勢適応、均衡の原則等の考えを基本に、我々といたしましては、"
    },
    {
      "start": 2641.21,
      "duration": 6.0,
      "text": "先ほど来ご説明させていただいている改定方針の考え方で一定、"
    },
    {
      "start": 2647.21,
      "duration": 7.0,
      "text": "今回全職収50円の引上げということで、職員団体とも協議の上、"
    },
    {
      "start": 2654.21,
      "duration": 4.0,
      "text": "というところでご理解いただければというふうに考えております"
    },
    {
      "start": 2658.21,
      "duration": 1.0,
      "text": "以上です"
    },
    {
      "start": 2659.21,
      "duration": 2.42,
      "text": "村部長"
    },
    {
      "start": 2661.63,
      "duration": 3.0,
      "text": "若干付属をさせていただきたいと思います"
    },
    {
      "start": 2664.63,
      "duration": 5.0,
      "text": "今、諸言課長の方からも答弁申し上げたとおりなんですが"
    },
    {
      "start": 2669.63,
      "duration": 2.0,
      "text": "今ご指摘ありましたとおりですね"
    },
    {
      "start": 2671.63,
      "duration": 5.0,
      "text": "他市との26人の均衡等も考えなければいけないところでありますし"
    },
    {
      "start": 2676.63,
      "duration": 4.0,
      "text": "あるいはまた人材確保ということから考えますと"
    },
    {
      "start": 2680.63,
      "duration": 5.0,
      "text": "近隣の死の動向とも見ていく必要があるかと思っております"
    },
    {
      "start": 2685.63,
      "duration": 4.0,
      "text": "来年度以降について今の時点で問うということはないんですが"
    },
    {
      "start": 2689.63,
      "duration": 2.0,
      "text": "今いただいたご意見も踏まえまして"
    },
    {
      "start": 2691.63,
      "duration": 2.0,
      "text": "また検討してまいりたいと思います"
    },
    {
      "start": 2693.63,
      "duration": 2.54,
      "text": "森戸さん"
    },
    {
      "start": 2696.17,
      "duration": 3.0,
      "text": "ぜひご検討をお願いしたいと思います"
    },
    {
      "start": 2699.17,
      "duration": 4.0,
      "text": "聞くところによれば一般事務などはですね"
    },
    {
      "start": 2703.17,
      "duration": 2.0,
      "text": "お隣の近隣死と比べても"
    },
    {
      "start": 2705.17,
      "duration": 5.0,
      "text": "近隣死の方が相当高い状況になっていて"
    },
    {
      "start": 2710.17,
      "duration": 2.0,
      "text": "ということでありまして"
    },
    {
      "start": 2712.17,
      "duration": 3.0,
      "text": "そういう点ではですね"
    },
    {
      "start": 2715.17,
      "duration": 6.0,
      "text": "やっぱりそのあたりで開いてくるのかなと思います"
    },
    {
      "start": 2721.17,
      "duration": 5.0,
      "text": "今、会計年度任用職員の方々がいらっしゃらなければ"
    },
    {
      "start": 2726.17,
      "duration": 4.0,
      "text": "全体の仕事も回っていかない"
    },
    {
      "start": 2730.17,
      "duration": 4.0,
      "text": "とりわけ専門職の部分はですね"
    },
    {
      "start": 2734.17,
      "duration": 5.0,
      "text": "極めて重要な役割を果たされている部分でもあります"
    },
    {
      "start": 2739.17,
      "duration": 15.0,
      "text": "あります。ずっと見ていますけれども、例えば精神保健福祉士がですね、4月から募集かけられていますが、今集まったのかな、ちょっと来られたのかどうか分かりませんけれども、"
    },
    {
      "start": 2754.17,
      "duration": 14.0,
      "text": "このあたりがですね、なかなか集まってきていないかなということでありまして、精神保健福祉士は三玉平均よりも上がっていますけれども、"
    },
    {
      "start": 2768.17,
      "duration": 8.03,
      "text": "やっぱり専門職の確保というのは 重要な観点だと思いますので"
    },
    {
      "start": 2776.2,
      "duration": 4.0,
      "text": "ぜひ市長においても 来年度を含めてですね"
    },
    {
      "start": 2780.2,
      "duration": 4.0,
      "text": "途中でもいいと思うんですが 挙げられるところがあれば"
    },
    {
      "start": 2784.2,
      "duration": 6.36,
      "text": "挙げていただきたいということは 申し上げておきたいと思います 以上です"
    },
    {
      "start": 2790.56,
      "duration": 2.0,
      "text": "お金ございますか"
    },
    {
      "start": 2792.56,
      "duration": 5.03,
      "text": "質疑を終了することにご意見はありませんか"
    },
    {
      "start": 2797.59,
      "duration": 3.26,
      "text": "ご意義なしと認め 質疑を終了します"
    },
    {
      "start": 2800.85,
      "duration": 3.32,
      "text": "お分かりします 本件は 委員会二区を省略し"
    },
    {
      "start": 2804.17,
      "duration": 3.84,
      "text": "討論採決を一時保留することに ご意義ありませんか"
    },
    {
      "start": 2808.01,
      "duration": 3.52,
      "text": "ご意義なしと認め 本件は委員会二区を省略し"
    },
    {
      "start": 2811.53,
      "duration": 4.45,
      "text": "討論採決を一時保留することと 決定しました"
    },
    {
      "start": 2815.98,
      "duration": 4.28,
      "text": "議会上委員会等を開催するため 暫く休憩します"
    }
  ]
}