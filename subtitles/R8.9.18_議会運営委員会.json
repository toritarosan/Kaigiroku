    },
    {
      "start": 94.32,
      "duration": 12.02,
      "text": "あと共産党はハチチン城第1号反対討論水紙です"
    },
    {
      "start": 106.34,
      "duration": 6.0,
      "text": "ハチチン城第1号政党機関室のやつ反対討論ですね"
    },
    {
      "start": 112.34,
      "duration": 5.0,
      "text": "あとはハチチン城第18号の反対討論が見えるかさん"
    },
    {
      "start": 117.34,
      "duration": 5.12,
      "text": "以上で討論はよろしいでしょうか"
    },
    {
      "start": 122.46,
      "duration": 5.0,
